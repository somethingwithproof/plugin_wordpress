{
  "name": "somethingwithproof/plugin-wordpress",
  "description": "Enterprise Cacti 1.2 plugin for monitoring WordPress fleets via Application Passwords, Site Health, WP-Cron, autoload bloat, and cache telemetry",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.2",
    "ext-json": "*",
    "ext-openssl": "*"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "Somethingwithproof\\WordPress\\": "lib/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Somethingwithproof\\WordPress\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit -c phpunit.xml",
    "test:integration": "phpunit -c phpunit-integration.xml",
    "phpstan": "phpstan analyse -c phpstan.neon --memory-limit=1G --no-progress"
  },
  "config": {
    "sort-packages": true
  }
}
