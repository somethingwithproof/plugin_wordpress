msgstr "Nuutste proefloop-ondersoekresultaat"

#: lib/Ui/PagesRenderer.php
msgid "Update Drift, Cron Stalls & Autoload Bloat"
msgstr "Opdateringsafwykings, Cron-stilstande en outolaai-opblaas"

#: lib/Ui/PagesRenderer.php
msgid "Vault Status:"
msgstr "Kluisstatus:"

#: lib/Ui/PagesRenderer.php
msgid "Add or Update WordPress Site"
msgstr "Voeg WordPress-werf by of werk op"

#: lib/Ui/PagesRenderer.php
msgid "Save Site"
msgstr "Stoor werf"

