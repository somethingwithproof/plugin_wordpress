#: lib/Settings.php
msgid "Vault Keyfile Path"
msgstr "የካዝና ቁልፍ ፋይል መንገድ"

#: lib/Settings.php
msgid "Absolute path to the external 256-bit AES-GCM keyfile used to encrypt Application Passwords at rest. Never replicated to remote pollers."
msgstr "የመተግበሪያ የይለፍ ቃላትን በማከማቻ ውስጥ ለማመስጠር የሚያገለግል የውጫዊ 256-bit AES-GCM ቁልፍ ፋይል ሙሉ መንገድ። ወደ ርቀት ፖለሮች በፍጹም አይባዛም።"

#: lib/Settings.php
msgid "Internal Host Allowlist"
msgstr "የውስጥ አስተናጋጅ ፍቃድ ዝርዝር"

#: lib/Settings.php
msgid "Comma-separated hostnames or wildcard patterns (e.g. *.corp.example) exempt from private-IP SSRF blocking."
msgstr "ከግል-IP SSRF እገዳ ነፃ የሆኑ በኮማ የተለዩ የአስተናጋጅ ስሞች ወይም የዋይልድካርድ ቅጦች (ለምሳሌ *.corp.example)።"

#: lib/Settings.php
msgid "Internal CIDR Allowlist"
msgstr "የውስጥ CIDR ፍቃድ ዝርዝር"

#: lib/Settings.php
msgid "Comma-separated internal CIDR ranges explicitly permitted by OutboundGuard."
msgstr "በOutboundGuard በግልጽ የተፈቀዱ በኮማ የተለዩ የውስጥ CIDR ክልሎች።"

#: lib/Settings.php
msgid "Outbound Client & Adaptive Poller Sizing"
msgstr "የውጪ ደንበኛ እና ተስማሚ የፖለር መጠን ማስተካከያ"

#: lib/Settings.php
msgid "Poll Interval (seconds)"
msgstr "የፍተሻ ክፍተት (ሰከንዶች)"

#: lib/Settings.php
msgid "Target fleet polling interval in seconds for Little's Law concurrency sizing."
msgstr "ለLittle's Law ተመሳሳይነት መጠን ማስተካከያ የታለመው የስብስብ ፍተሻ ክፍተት በሰከንዶች።"

#: lib/Settings.php
msgid "Connect Timeout (seconds)"
msgstr "የግንኙነት ጊዜ ማብቂያ (ሰከንዶች)"

#: lib/Settings.php
msgid "Maximum TCP/TLS connect duration per WordPress probe (1-15s)."
msgstr "በእያንዳንዱ የWordPress ፍተሻ ከፍተኛው የTCP/TLS ግንኙነት ቆይታ (1-15s)።"

#: lib/Settings.php
msgid "Read Timeout (seconds)"
msgstr "የንባብ ጊዜ ማብቂያ (ሰከንዶች)"

#: lib/Settings.php
msgid "Maximum total HTTP read duration per WordPress probe (1-60s)."
msgstr "በእያንዳንዱ የWordPress ፍተሻ ከፍተኛው አጠቃላይ የHTTP ንባብ ቆይታ (1-60s)።"

#: lib/Settings.php
msgid "Max Response Size (bytes)"
msgstr "ከፍተኛው የምላሽ መጠን (ባይቶች)"

#: lib/Settings.php
msgid "Hard byte ceiling per HTTP response (capped at 2097152 bytes / 2 MiB)."
msgstr "በእያንዳንዱ HTTP ምላሽ ጠንካራ የባይት ገደብ (እስከ 2097152 ባይቶች / 2 MiB የተገደበ)።"

#: lib/Settings.php
msgid "CoDel Target Standing Delay (ms)"
msgstr "የCoDel ዒላማ ቋሚ መዘግየት (ms)"

#: lib/Settings.php
msgid "Queue standing-delay target in milliseconds before adaptive concurrency backs off."
msgstr "ተስማሚ ተመሳሳይነት ከመቀነሱ በፊት የወረፋ ቋሚ መዘግየት ዒላማ በሚሊሰከንዶች።"

#: lib/Settings.php
msgid "Minimum Concurrency"
msgstr "ዝቅተኛ ተመሳሳይነት"

#: lib/Settings.php
msgid "Lower bound on concurrent WordPress probe workers per collector shard."
msgstr "በእያንዳንዱ ሰብሳቢ ክፍል ለተመሳሳይ የWordPress ፍተሻ ሰራተኞች ዝቅተኛ ገደብ።"

#: lib/Settings.php
msgid "Maximum Concurrency"
msgstr "ከፍተኛ ተመሳሳይነት"

#: lib/Settings.php
msgid "Upper bound on concurrent WordPress probe workers per collector shard."
msgstr "በእያንዳንዱ ሰብሳቢ ክፍል ለተመሳሳይ የWordPress ፍተሻ ሰራተኞች ከፍተኛ ገደብ።"

#: lib/Settings.php
msgid "HTTP User-Agent"
msgstr "የHTTP User-Agent ራስጌ"

#: lib/Settings.php
msgid "User-Agent header sent on read-only REST and Site Health probes."
msgstr "ለንባብ ብቻ በሚሆኑ የREST እና የጣቢያ ጤና ፍተሻዎች ላይ የሚላክ የUser-Agent ራስጌ።"

#: lib/Settings.php
msgid "Fleet Health & Thold Thresholds"
msgstr "የስብስብ ጤና እና የThold ገደቦች"

#: lib/Settings.php
msgid "Default Apdex T (ms)"
msgstr "ነባሪ Apdex T (ms)"

#: lib/Settings.php
msgid "Satisfied TTFB threshold T in milliseconds (tolerating threshold is 4T)."
msgstr "አርኪ የTTFB ገደብ T በሚሊሰከንዶች (ተቀባይነት ያለው ገደብ 4T ነው)።"

#: lib/Settings.php
msgid "Autoload Bloat Warning (bytes)"
msgstr "የራስ-ጭነት መብዛት ማስጠንቀቂያ (ባይቶች)"

#: lib/Settings.php
msgid "wp_options autoloaded size warning threshold (default 819200 / 800 KiB)."
msgstr "የwp_options ራስ-ጭነት መጠን ማስጠንቀቂያ ገደብ (ነባሪ 819200 / 800 KiB)።"

#: lib/Settings.php
msgid "Autoload Bloat Critical (bytes)"
msgstr "ከባድ የራስ-ጭነት መብዛት (ባይቶች)"

#: lib/Settings.php
msgid "wp_options autoloaded size critical threshold (default 2097152 / 2 MiB)."
msgstr "የwp_options ራስ-ጭነት መጠን ከባድ ገደብ (ነባሪ 2097152 / 2 MiB)።"

