#: lib/Pages.php
msgid "WordPress View"
msgstr "عرض WordPress"

#: lib/Pages.php
msgid "WordPress Operator"
msgstr "مشغّل WordPress"

#: lib/Pages.php
msgid "WordPress Admin"
msgstr "مدير WordPress"

#: lib/Pages.php
msgid "WordPress Fleet Overview"
msgstr "نظرة عامة على أسطول WordPress"

#: lib/Pages.php
msgid "WordPress Drift & Probes"
msgstr "انحرافات وفحوصات WordPress"

#: lib/Pages.php
msgid "WordPress Inventory & Vault"
msgstr "جرد مواقع WordPress والخزنة"

#: lib/Settings.php
msgid "WordPress Fleet Security & Vault"
msgstr "أمان أسطول WordPress والخزنة"

#: lib/Settings.php
msgid "Vault Keyfile Path"
msgstr "مسار ملف مفتاح الخزنة"

#: lib/Settings.php
msgid "Absolute path to the external 256-bit AES-GCM keyfile used to encrypt Application Passwords at rest. Never replicated to remote pollers."
msgstr "المسار الكامل لملف المفتاح الخارجي 256-bit AES-GCM المستخدم لتشفير كلمات مرور التطبيقات أثناء التخزين. لا يتم نسخه مطلقاً إلى وحدات الاستطلاع البعيدة."

#: lib/Settings.php
msgid "Internal Host Allowlist"
msgstr "قائمة المضيفين الداخليين المسموح بهم"

#: lib/Settings.php
msgid "Comma-separated hostnames or wildcard patterns (e.g. *.corp.example) exempt from private-IP SSRF blocking."
msgstr "أسماء مضيفين أو أنماط بدل مفصولة بفواصل (مثل *.corp.example) مستثناة من حظر SSRF لعناوين IP الخاصة."

#: lib/Settings.php
msgid "Internal CIDR Allowlist"
msgstr "قائمة نطاقات CIDR الداخلية المسموح بها"

#: lib/Settings.php
msgid "Comma-separated internal CIDR ranges explicitly permitted by OutboundGuard."
msgstr "نطاقات CIDR الداخلية المفصولة بفواصل والمسموح بها صراحةً بواسطة OutboundGuard."

#: lib/Settings.php
msgid "Outbound Client & Adaptive Poller Sizing"
msgstr "العميل الصادر وتحجيم الاستطلاع التكيفي"

#: lib/Settings.php
msgid "Poll Interval (seconds)"
msgstr "الفاصل الزمني للاستطلاع (بالثواني)"

#: lib/Settings.php
msgid "Target fleet polling interval in seconds for Little's Law concurrency sizing."
msgstr "الفاصل الزمني المستهدف لاستطلاع الأسطول بالثواني لحساب التزامن وفقاً لـ Little's Law."

#: lib/Settings.php
msgid "Connect Timeout (seconds)"
msgstr "مهلة الاتصال (بالثواني)"

#: lib/Settings.php
msgid "Maximum TCP/TLS connect duration per WordPress probe (1-15s)."
msgstr "الحد الأقصى لمدة اتصال TCP/TLS لكل فحص WordPress (1-15s)."

#: lib/Settings.php
msgid "Read Timeout (seconds)"
msgstr "مهلة القراءة (بالثواني)"

#: lib/Settings.php
msgid "Maximum total HTTP read duration per WordPress probe (1-60s)."
msgstr "الحد الأقصى لإجمالي مدة قراءة HTTP لكل فحص WordPress (1-60s)."

#: lib/Settings.php
msgid "Max Response Size (bytes)"
msgstr "الحد الأقصى لحجم الاستجابة (بالبايت)"

#: lib/Settings.php
msgid "Hard byte ceiling per HTTP response (capped at 2097152 bytes / 2 MiB)."
msgstr "سقف صارم بالبايت لكل استجابة HTTP (بحد أقصى 2097152 بايت / 2 MiB)."

#: lib/Settings.php
msgid "CoDel Target Standing Delay (ms)"
msgstr "تأخير الانتظار المستهدف لـ CoDel (ms)"

#: lib/Settings.php
msgid "Queue standing-delay target in milliseconds before adaptive concurrency backs off."
msgstr "الحد المستهدف لتأخير قائمة الانتظار بالمللي ثانية قبل تراجع التزامن التكيفي."

#: lib/Settings.php
msgid "Minimum Concurrency"
msgstr "الحد الأدنى للتزامن"

#: lib/Settings.php
msgid "Lower bound on concurrent WordPress probe workers per collector shard."
msgstr "الحد الأدنى لعدد عمليات فحص WordPress المتزامنة لكل جزء جامع بيانات."

#: lib/Settings.php
msgid "Maximum Concurrency"
msgstr "الحد الأقصى للتزامن"

#: lib/Settings.php
msgid "Upper bound on concurrent WordPress probe workers per collector shard."
msgstr "الحد الأقصى لعدد عمليات فحص WordPress المتزامنة لكل جزء جامع بيانات."

#: lib/Settings.php
msgid "HTTP User-Agent"
msgstr "ترويسة HTTP User-Agent"

#: lib/Settings.php
msgid "User-Agent header sent on read-only REST and Site Health probes."
msgstr "ترويسة User-Agent المرسلة في فحوصات REST وصحة الموقع للقراءة فقط."

#: lib/Settings.php
msgid "Fleet Health & Thold Thresholds"
msgstr "صحة الأسطول وحدود Thold"

#: lib/Settings.php
msgid "Default Apdex T (ms)"
msgstr "قيمة Apdex T الافتراضية (ms)"

#: lib/Settings.php
msgid "Satisfied TTFB threshold T in milliseconds (tolerating threshold is 4T)."
msgstr "حد TTFB المُرضي T بالمللي ثانية (الحد المقبول هو 4T)."

#: lib/Settings.php
msgid "Autoload Bloat Warning (bytes)"
msgstr "تحذير تضخم التحميل التلقائي (بالبايت)"

#: lib/Settings.php
msgid "wp_options autoloaded size warning threshold (default 819200 / 800 KiB)."
msgstr "حد التحذير لحجم البيانات المحمّلة تلقائياً في wp_options (الافتراضي 819200 / 800 KiB)."

#: lib/Settings.php
msgid "Autoload Bloat Critical (bytes)"
msgstr "حد حرج لتضخم التحميل التلقائي (بالبايت)"

#: lib/Settings.php
msgid "wp_options autoloaded size critical threshold (default 2097152 / 2 MiB)."
msgstr "الحد الحرج لحجم البيانات المحمّلة تلقائياً في wp_options (الافتراضي 2097152 / 2 MiB)."

#: lib/Settings.php
msgid "WP-Cron Lag Warning (seconds)"
msgstr "تحذير تأخر WP-Cron (بالثواني)"

#: lib/Settings.php
msgid "Oldest overdue WP-Cron job lag threshold for degraded status."
msgstr "حد تأخر أقدم مهمة WP-Cron متأخرة لتفعيل الحالة المتدهورة."

#: lib/Settings.php
msgid "TLS Expiry Warning (days)"
msgstr "تحذير انتهاء صلاحية TLS (بالأيام)"

#: lib/Settings.php
msgid "Days before TLS certificate expiry triggering degraded status."
msgstr "عدد الأيام قبل انتهاء شهادة TLS لتفعيل الحالة المتدهورة."

#: lib/Settings.php
msgid "TLS Expiry Critical (days)"
msgstr "حد حرج لانتهاء صلاحية TLS (بالأيام)"

#: lib/Settings.php
msgid "Days before TLS certificate expiry triggering critical status."
msgstr "عدد الأيام قبل انتهاء شهادة TLS لتفعيل الحالة الحرجة."

#: lib/Settings.php
msgid "Keep Tables on Uninstall"
msgstr "الاحتفاظ بالجداول عند إلغاء التثبيت"

#: lib/Settings.php
msgid "Preserve plugin_wordpress database tables when uninstalling the plugin."
msgstr "الاحتفاظ بجداول قاعدة بيانات plugin_wordpress عند إلغاء تثبيت الملحق."

