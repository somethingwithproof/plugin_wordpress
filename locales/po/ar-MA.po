#: lib/Pages.php
msgid "WordPress View"
msgstr "معاينة WordPress"

#: lib/Pages.php
msgid "WordPress Operator"
msgstr "مشغّل WordPress"

#: lib/Pages.php
msgid "WordPress Admin"
msgstr "مسؤول WordPress"

#: lib/Pages.php
msgid "WordPress Fleet Overview"
msgstr "نظرة شاملة على حظيرة WordPress"

#: lib/Pages.php
msgid "WordPress Drift & Probes"
msgstr "انحرافات وفحوصات WordPress"

#: lib/Pages.php
msgid "WordPress Inventory & Vault"
msgstr "جرد WordPress والخزنة"

#: lib/Settings.php
msgid "WordPress Fleet Security & Vault"
msgstr "أمن حظيرة WordPress والخزنة"

#: lib/Settings.php
msgid "Vault Keyfile Path"
msgstr "مسار ملف مفتاح الخزنة"

#: lib/Settings.php
msgid "Absolute path to the external 256-bit AES-GCM keyfile used to encrypt Application Passwords at rest. Never replicated to remote pollers."
msgstr "المسار المطلق لملف المفتاح الخارجي 256-bit AES-GCM المستعمل لتشفير كلمات مرور التطبيقات عند التخزين. لا يُنسخ أبداً إلى مُستطلِعات عن بُعد."

#: lib/Settings.php
msgid "Internal Host Allowlist"
msgstr "لائحة المضيفين الداخليين المسموح بهم"

#: lib/Settings.php
msgid "Comma-separated hostnames or wildcard patterns (e.g. *.corp.example) exempt from private-IP SSRF blocking."
msgstr "أسماء مضيفين أو أنماط بديلة مفصولة بفواصل (مثل *.corp.example) مستثناة من حجب SSRF لعناوين IP الخاصة."

#: lib/Settings.php
msgid "Internal CIDR Allowlist"
msgstr "لائحة نطاقات CIDR الداخلية المسموح بها"

#: lib/Settings.php
msgid "Comma-separated internal CIDR ranges explicitly permitted by OutboundGuard."
msgstr "نطاقات CIDR الداخلية المفصولة بفواصل والمرخّص لها صراحةً عبر OutboundGuard."

#: lib/Settings.php
msgid "Outbound Client & Adaptive Poller Sizing"
msgstr "العميل الصادر وتحديد حجم المُستطلِع التكيّفي"

#: lib/Settings.php
msgid "Poll Interval (seconds)"
msgstr "الفاصل الزمني للاستطلاع (بالثواني)"

#: lib/Settings.php
msgid "Target fleet polling interval in seconds for Little's Law concurrency sizing."
msgstr "الفاصل الزمني المستهدف لاستطلاع الحظيرة بالثواني لتحديد التزامن حسب Little's Law."

#: lib/Settings.php
msgid "Connect Timeout (seconds)"
msgstr "مهلة الاتصال (بالثواني)"

#: lib/Settings.php
msgid "Maximum TCP/TLS connect duration per WordPress probe (1-15s)."
msgstr "المدة القصوى لاتصال TCP/TLS لكل فحص WordPress (1-15s)."

#: lib/Settings.php
msgid "Read Timeout (seconds)"
msgstr "مهلة القراءة (بالثواني)"

#: lib/Settings.php
msgid "Maximum total HTTP read duration per WordPress probe (1-60s)."
msgstr "المدة الإجمالية القصوى لقراءة HTTP لكل فحص WordPress (1-60s)."

#: lib/Settings.php
msgid "Max Response Size (bytes)"
msgstr "الحجم الأقصى للاستجابة (بالبايت)"

#: lib/Settings.php
msgid "Hard byte ceiling per HTTP response (capped at 2097152 bytes / 2 MiB)."
msgstr "سقف صارم بالبايت لكل استجابة HTTP (محدّد في 2097152 بايت / 2 MiB)."

#: lib/Settings.php
msgid "CoDel Target Standing Delay (ms)"
msgstr "تأخير الانتظار المستهدف لـ CoDel (ms)"

#: lib/Settings.php
msgid "Queue standing-delay target in milliseconds before adaptive concurrency backs off."
msgstr "التأخير المستهدف في طابور الانتظار بالمللي ثانية قبل خفض التزامن التكيّفي."

#: lib/Settings.php
msgid "Minimum Concurrency"
msgstr "الحد الأدنى للتزامن"

#: lib/Settings.php
msgid "Lower bound on concurrent WordPress probe workers per collector shard."
msgstr "الحد الأدنى لعمليات فحص WordPress المتزامنة لكل شريحة تجميع."

#: lib/Settings.php
msgid "Maximum Concurrency"
msgstr "الحد الأقصى للتزامن"

#: lib/Settings.php
msgid "Upper bound on concurrent WordPress probe workers per collector shard."
msgstr "الحد الأقصى لعمليات فحص WordPress المتزامنة لكل شريحة تجميع."

#: lib/Settings.php
msgid "HTTP User-Agent"
msgstr "ترويسة HTTP User-Agent"

#: lib/Settings.php
msgid "User-Agent header sent on read-only REST and Site Health probes."
msgstr "ترويسة User-Agent المُرسلة خلال فحوصات REST وصحة الموقع للقراءة فقط."

#: lib/Settings.php
msgid "Fleet Health & Thold Thresholds"
msgstr "صحة الحظيرة وعتبات Thold"

#: lib/Settings.php
msgid "Default Apdex T (ms)"
msgstr "عتبة Apdex T الافتراضية (ms)"

#: lib/Settings.php
msgid "Satisfied TTFB threshold T in milliseconds (tolerating threshold is 4T)."
msgstr "عتبة TTFB المُرضية T بالمللي ثانية (عتبة التسامح هي 4T)."

#: lib/Settings.php
msgid "Autoload Bloat Warning (bytes)"
msgstr "تنبيه تضخّم التحميل التلقائي (بالبايت)"

#: lib/Settings.php
msgid "wp_options autoloaded size warning threshold (default 819200 / 800 KiB)."
msgstr "عتبة التنبيه لحجم المعطيات المحمّلة تلقائياً في wp_options (الافتراضي 819200 / 800 KiB)."

#: lib/Settings.php
msgid "Autoload Bloat Critical (bytes)"
msgstr "عتبة حرجة لتضخّم التحميل التلقائي (بالبايت)"

#: lib/Settings.php
msgid "wp_options autoloaded size critical threshold (default 2097152 / 2 MiB)."
msgstr "العتبة الحرجة لحجم المعطيات المحمّلة تلقائياً في wp_options (الافتراضي 2097152 / 2 MiB)."

#: lib/Settings.php
msgid "WP-Cron Lag Warning (seconds)"
msgstr "تنبيه تأخّر WP-Cron (بالثواني)"

#: lib/Settings.php
msgid "Oldest overdue WP-Cron job lag threshold for degraded status."
msgstr "عتبة تأخّر أقدم مهمة WP-Cron متأخرة لإعلان حالة متدهورة."

#: lib/Settings.php
msgid "TLS Expiry Warning (days)"
msgstr "تنبيه انتهاء صلاحية TLS (بالأيام)"

#: lib/Settings.php
msgid "Days before TLS certificate expiry triggering degraded status."
msgstr "عدد الأيام قبل انتهاء صلاحية شهادة TLS لإعلان حالة متدهورة."

#: lib/Settings.php
msgid "TLS Expiry Critical (days)"
msgstr "عتبة حرجة لانتهاء صلاحية TLS (بالأيام)"

#: lib/Settings.php
msgid "Days before TLS certificate expiry triggering critical status."
msgstr "عدد الأيام قبل انتهاء صلاحية شهادة TLS لإعلان حالة حرجة."

#: lib/Settings.php
msgid "Keep Tables on Uninstall"
msgstr "الاحتفاظ بالجداول عند إزالة التثبيت"

#: lib/Settings.php
msgid "Preserve plugin_wordpress database tables when uninstalling the plugin."
msgstr "الاحتفاظ بجداول قاعدة المعطيات plugin_wordpress عند إزالة تثبيت الملحق."

