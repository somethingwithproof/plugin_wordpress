msgstr "WordPress Администратор"

#: lib/Pages.php
msgid "WordPress Fleet Overview"
msgstr "Преглед на WordPress флотата"

#: lib/Pages.php
msgid "WordPress Drift & Probes"
msgstr "WordPress отклонения и проверки"

#: lib/Pages.php
msgid "WordPress Inventory & Vault"
msgstr "WordPress инвентар и трезор"

#: lib/Settings.php
msgid "WordPress Fleet Security & Vault"
msgstr "Сигурност и трезор на WordPress флотата"

#: lib/Settings.php
msgid "Vault Keyfile Path"
msgstr "Път до ключовия файл на трезора"

#: lib/Settings.php
msgid "Absolute path to the external 256-bit AES-GCM keyfile used to encrypt Application Passwords at rest. Never replicated to remote pollers."
msgstr "Абсолютен път до външния 256-bit AES-GCM ключов файл, използван за криптиране на паролите за приложения в покой. Никога не се репликира към отдалечени полъри."

#: lib/Settings.php
msgid "Internal Host Allowlist"
msgstr "Списък с разрешени вътрешни хостове"

#: lib/Settings.php
msgid "Comma-separated hostnames or wildcard patterns (e.g. *.corp.example) exempt from private-IP SSRF blocking."
msgstr "Разделени със запетая имена на хостове или шаблони със заместващи знаци (напр. *.corp.example), освободени от блокиране на SSRF за частни IP адреси."

#: lib/Settings.php
msgid "Internal CIDR Allowlist"
msgstr "Списък с разрешени вътрешни CIDR диапазони"

#: lib/Settings.php
msgid "Comma-separated internal CIDR ranges explicitly permitted by OutboundGuard."
msgstr "Разделени със запетая вътрешни CIDR диапазони, изрично разрешени от OutboundGuard."

#: lib/Settings.php
msgid "Outbound Client & Adaptive Poller Sizing"
msgstr "Изходящ клиент и адаптивно оразмеряване на полъра"

#: lib/Settings.php
msgid "Poll Interval (seconds)"
msgstr "Интервал на запитване (секунди)"

#: lib/Settings.php
msgid "Target fleet polling interval in seconds for Little's Law concurrency sizing."
msgstr "Целеви интервал за запитване на флотата в секунди за оразмеряване на конкурентността по Little's Law."

#: lib/Settings.php
msgid "Connect Timeout (seconds)"
msgstr "Време за изчакване при свързване (секунди)"

#: lib/Settings.php
msgid "Maximum TCP/TLS connect duration per WordPress probe (1-15s)."
msgstr "Максимална продължителност на TCP/TLS свързване за една WordPress проверка (1-15s)."

#: lib/Settings.php
msgid "Read Timeout (seconds)"
msgstr "Време за изчакване при четене (секунди)"

#: lib/Settings.php
msgid "Maximum total HTTP read duration per WordPress probe (1-60s)."
msgstr "Максимална обща продължителност на HTTP четене за една WordPress проверка (1-60s)."

#: lib/Settings.php
msgid "Max Response Size (bytes)"
msgstr "Максимален размер на отговора (байтове)"

#: lib/Settings.php
msgid "Hard byte ceiling per HTTP response (capped at 2097152 bytes / 2 MiB)."
msgstr "Твърд лимит в байтове за един HTTP отговор (ограничен до 2097152 байта / 2 MiB)."

#: lib/Settings.php
msgid "CoDel Target Standing Delay (ms)"
msgstr "Целево постоянно закъснение на CoDel (ms)"

#: lib/Settings.php
msgid "Queue standing-delay target in milliseconds before adaptive concurrency backs off."
msgstr "Целево постоянно закъснение в опашката в милисекунди преди адаптивната конкурентност да се намали."

#: lib/Settings.php
msgid "Minimum Concurrency"
msgstr "Минимална конкурентност"

#: lib/Settings.php
msgid "Lower bound on concurrent WordPress probe workers per collector shard."
msgstr "Долна граница за конкурентните работници за WordPress проверки на сегмент от събирача."

#: lib/Settings.php
msgid "Maximum Concurrency"
msgstr "Максимална конкурентност"

#: lib/Settings.php
msgid "Upper bound on concurrent WordPress probe workers per collector shard."
msgstr "Горна граница за конкурентните работници за WordPress проверки на сегмент от събирача."

#: lib/Settings.php
msgid "HTTP User-Agent"
msgstr "HTTP User-Agent заглавка"

#: lib/Settings.php
msgid "User-Agent header sent on read-only REST and Site Health probes."
msgstr "Заглавка User-Agent, изпращана при проверки само за четене на REST и състоянието на сайта."

#: lib/Settings.php
msgid "Fleet Health & Thold Thresholds"
msgstr "Състояние на флотата и прагове на Thold"

#: lib/Settings.php
msgid "Default Apdex T (ms)"
msgstr "Стандартен Apdex T (ms)"

#: lib/Settings.php
msgid "Satisfied TTFB threshold T in milliseconds (tolerating threshold is 4T)."
msgstr "Праг на удовлетвореност T за TTFB в милисекунди (прагът на толерантност е 4T)."

#: lib/Settings.php
msgid "Autoload Bloat Warning (bytes)"
msgstr "Предупреждение за претоварване на автозареждането (байтове)"

#: lib/Settings.php
msgid "wp_options autoloaded size warning threshold (default 819200 / 800 KiB)."
msgstr "Предупредителен праг за размера на автозарежданите данни в wp_options (по подразбиране 819200 / 800 KiB)."

#: lib/Settings.php
msgid "Autoload Bloat Critical (bytes)"
msgstr "Критично претоварване на автозареждането (байтове)"

#: lib/Settings.php
msgid "wp_options autoloaded size critical threshold (default 2097152 / 2 MiB)."
msgstr "Критичен праг за размера на автозарежданите данни в wp_options (по подразбиране 2097152 / 2 MiB)."

#: lib/Settings.php
msgid "WP-Cron Lag Warning (seconds)"
msgstr "Предупреждение за забавяне на WP-Cron (секунди)"

#: lib/Settings.php
msgid "Oldest overdue WP-Cron job lag threshold for degraded status."
msgstr "Праг на забавяне на най-старата просрочена задача в WP-Cron за влошено състояние."

#: lib/Settings.php
msgid "TLS Expiry Warning (days)"
msgstr "Предупреждение за изтичане на TLS (дни)"

#: lib/Settings.php
msgid "Days before TLS certificate expiry triggering degraded status."
msgstr "Дни преди изтичането на TLS сертификата, задействащи влошено състояние."

#: lib/Settings.php
msgid "TLS Expiry Critical (days)"
msgstr "Критично изтичане на TLS (дни)"

#: lib/Settings.php
msgid "Days before TLS certificate expiry triggering critical status."
msgstr "Дни преди изтичането на TLS сертификата, задействащи критично състояние."

#: lib/Settings.php
msgid "Keep Tables on Uninstall"
msgstr "Запазване на таблиците при деинсталиране"

#: lib/Settings.php
msgid "Preserve plugin_wordpress database tables when uninstalling the plugin."
msgstr "Запазване на таблиците plugin_wordpress в базата данни при деинсталиране на добавката."

#: lib/Ui/PagesRenderer.php
msgid "Fleet Health Summary"
msgstr "Обобщение за състоянието на флотата"

