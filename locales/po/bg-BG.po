#: lib/Ui/PagesRenderer.php
msgid "Run Read-Only Probe"
msgstr "Изпълни проверка само за четене"

#: lib/Ui/PagesRenderer.php
msgid "Latest Dry-Run Probe Result"
msgstr "Последен резултат от пробна проверка"

#: lib/Ui/PagesRenderer.php
msgid "Update Drift, Cron Stalls & Autoload Bloat"
msgstr "Отклонения в актуализациите, застояли Cron задачи и претоварване на автозареждането"

#: lib/Ui/PagesRenderer.php
msgid "Vault Status:"
msgstr "Състояние на трезора:"

#: lib/Ui/PagesRenderer.php
msgid "Add or Update WordPress Site"
msgstr "Добавяне или актуализиране на WordPress сайт"

