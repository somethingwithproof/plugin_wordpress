msgstr "Posljednji rezultat probne provjere"

#: lib/Ui/PagesRenderer.php
msgid "Update Drift, Cron Stalls & Autoload Bloat"
msgstr "Odstupanja ažuriranja, zastoji Cron zadataka i preopterećenje automatskog učitavanja"

#: lib/Ui/PagesRenderer.php
