#: lib/Settings.php
msgid "WordPress Fleet Security & Vault"
msgstr "Sigurnost WordPress flote i trezor"

#: lib/Settings.php
msgid "Vault Keyfile Path"
msgstr "Putanja datoteke ključa trezora"

#: lib/Settings.php
msgid "Absolute path to the external 256-bit AES-GCM keyfile used to encrypt Application Passwords at rest. Never replicated to remote pollers."
msgstr "Apsolutna putanja do eksterne 256-bit AES-GCM datoteke ključa koja se koristi za šifriranje lozinki aplikacija u mirovanju. Nikada se ne replicira na udaljene polere."

#: lib/Settings.php
msgid "Internal Host Allowlist"
msgstr "Lista dozvoljenih internih hostova"

#: lib/Settings.php
msgid "Comma-separated hostnames or wildcard patterns (e.g. *.corp.example) exempt from private-IP SSRF blocking."
msgstr "Imena hostova ili zamjenski obrasci odvojeni zarezom (npr. *.corp.example) izuzeti iz SSRF blokiranja privatnih IP adresa."

#: lib/Settings.php
msgid "Internal CIDR Allowlist"
msgstr "Lista dozvoljenih internih CIDR opsega"

#: lib/Settings.php
msgid "Comma-separated internal CIDR ranges explicitly permitted by OutboundGuard."
msgstr "Interni CIDR opsezi odvojeni zarezom koje OutboundGuard izričito dozvoljava."

#: lib/Settings.php
msgid "Outbound Client & Adaptive Poller Sizing"
msgstr "Odlazni klijent i adaptivno dimenzionisanje polera"

#: lib/Settings.php
msgid "Poll Interval (seconds)"
msgstr "Interval ispitivanja (sekunde)"

#: lib/Settings.php
msgid "Target fleet polling interval in seconds for Little's Law concurrency sizing."
msgstr "Ciljani interval ispitivanja flote u sekundama za dimenzionisanje istovremenosti prema Little's Law."

#: lib/Settings.php
msgid "Connect Timeout (seconds)"
msgstr "Istek vremena povezivanja (sekunde)"

#: lib/Settings.php
msgid "Maximum TCP/TLS connect duration per WordPress probe (1-15s)."
msgstr "Maksimalno trajanje TCP/TLS povezivanja po WordPress provjeri (1-15s)."

#: lib/Settings.php
msgid "Read Timeout (seconds)"
msgstr "Istek vremena čitanja (sekunde)"

#: lib/Settings.php
msgid "Maximum total HTTP read duration per WordPress probe (1-60s)."
msgstr "Maksimalno ukupno trajanje HTTP čitanja po WordPress provjeri (1-60s)."

#: lib/Settings.php
msgid "Max Response Size (bytes)"
msgstr "Maksimalna veličina odgovora (bajtovi)"

#: lib/Settings.php
msgid "Hard byte ceiling per HTTP response (capped at 2097152 bytes / 2 MiB)."
msgstr "Čvrsta gornja granica u bajtovima po HTTP odgovoru (ograničeno na 2097152 bajtova / 2 MiB)."

#: lib/Settings.php
msgid "CoDel Target Standing Delay (ms)"
msgstr "CoDel ciljno stalno kašnjenje (ms)"

#: lib/Settings.php
msgid "Queue standing-delay target in milliseconds before adaptive concurrency backs off."
msgstr "Ciljno stalno kašnjenje u redu čekanja u milisekundama prije nego što se adaptivna istovremenost smanji."

#: lib/Settings.php
msgid "Minimum Concurrency"
msgstr "Minimalna istovremenost"

#: lib/Settings.php
msgid "Lower bound on concurrent WordPress probe workers per collector shard."
msgstr "Donja granica istovremenih radnika za WordPress provjere po segmentu sakupljača."

#: lib/Settings.php
msgid "Maximum Concurrency"
msgstr "Maksimalna istovremenost"

#: lib/Settings.php
msgid "Upper bound on concurrent WordPress probe workers per collector shard."
msgstr "Gornja granica istovremenih radnika za WordPress provjere po segmentu sakupljača."

#: lib/Settings.php
msgid "HTTP User-Agent"
msgstr "HTTP User-Agent zaglavlje"

#: lib/Settings.php
msgid "User-Agent header sent on read-only REST and Site Health probes."
msgstr "Zaglavlje User-Agent koje se šalje pri REST provjerama i provjerama zdravlja stranice samo za čitanje."

#: lib/Settings.php
msgid "Fleet Health & Thold Thresholds"
msgstr "Zdravlje flote i Thold pragovi"

#: lib/Settings.php
msgid "Default Apdex T (ms)"
msgstr "Zadani Apdex T (ms)"

#: lib/Settings.php
msgid "Satisfied TTFB threshold T in milliseconds (tolerating threshold is 4T)."
msgstr "Zadovoljavajući TTFB prag T u milisekundama (prag tolerancije je 4T)."

#: lib/Settings.php
msgid "Autoload Bloat Warning (bytes)"
msgstr "Upozorenje za preopterećenje automatskog učitavanja (bajtovi)"

#: lib/Settings.php
msgid "wp_options autoloaded size warning threshold (default 819200 / 800 KiB)."
msgstr "Prag upozorenja za veličinu automatski učitanih podataka u wp_options (zadano 819200 / 800 KiB)."

#: lib/Settings.php
msgid "Autoload Bloat Critical (bytes)"
msgstr "Kritično preopterećenje automatskog učitavanja (bajtovi)"

#: lib/Settings.php
msgid "wp_options autoloaded size critical threshold (default 2097152 / 2 MiB)."
msgstr "Kritični prag za veličinu automatski učitanih podataka u wp_options (zadano 2097152 / 2 MiB)."

#: lib/Settings.php
msgid "WP-Cron Lag Warning (seconds)"
msgstr "Upozorenje za kašnjenje WP-Cron (sekunde)"

#: lib/Settings.php
msgid "Oldest overdue WP-Cron job lag threshold for degraded status."
msgstr "Prag kašnjenja najstarijeg zakasnjelog WP-Cron zadatka za degradirani status."

#: lib/Settings.php
msgid "TLS Expiry Warning (days)"
msgstr "Upozorenje za istek TLS certifikata (dani)"

#: lib/Settings.php
msgid "Days before TLS certificate expiry triggering degraded status."
msgstr "Broj dana prije isteka TLS certifikata koji pokreće degradirani status."

#: lib/Settings.php
msgid "TLS Expiry Critical (days)"
msgstr "Kritični istek TLS certifikata (dani)"

#: lib/Settings.php
msgid "Days before TLS certificate expiry triggering critical status."
msgstr "Broj dana prije isteka TLS certifikata koji pokreće kritični status."

#: lib/Settings.php
msgid "Keep Tables on Uninstall"
msgstr "Zadrži tabele pri deinstalaciji"

#: lib/Settings.php
msgid "Preserve plugin_wordpress database tables when uninstalling the plugin."
msgstr "Sačuvaj plugin_wordpress tabele baze podataka prilikom deinstalacije dodatka."

