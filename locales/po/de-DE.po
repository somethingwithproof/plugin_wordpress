msgstr "WordPress-Inventar & Tresor"

#: lib/Settings.php
msgid "WordPress Fleet Security & Vault"
msgstr "WordPress-Flottensicherheit & Tresor"

#: lib/Settings.php
msgid "Vault Keyfile Path"
msgstr "Pfad zur Tresor-Schlüsseldatei"

#: lib/Settings.php
msgid "Absolute path to the external 256-bit AES-GCM keyfile used to encrypt Application Passwords at rest. Never replicated to remote pollers."
msgstr "Absoluter Pfad zur externen 256-bit AES-GCM-Schlüsseldatei zum Verschlüsseln von Anwendungspasswörtern im Ruhezustand. Wird niemals auf entfernte Poller repliziert."

#: lib/Settings.php
msgid "Internal Host Allowlist"
msgstr "Zulassungsliste für interne Hosts"

#: lib/Settings.php
msgid "Comma-separated hostnames or wildcard patterns (e.g. *.corp.example) exempt from private-IP SSRF blocking."
msgstr "Kommagetrennte Hostnamen oder Platzhaltermuster (z. B. *.corp.example), die von der SSRF-Blockierung privater IP-Adressen ausgenommen sind."

#: lib/Settings.php
msgid "Internal CIDR Allowlist"
msgstr "Zulassungsliste für interne CIDR-Bereiche"

#: lib/Settings.php
msgid "Comma-separated internal CIDR ranges explicitly permitted by OutboundGuard."
msgstr "Kommagetrennte interne CIDR-Bereiche, die von OutboundGuard ausdrücklich zugelassen sind."

#: lib/Settings.php
msgid "Outbound Client & Adaptive Poller Sizing"
msgstr "Ausgehender Client & adaptive Poller-Dimensionierung"

#: lib/Settings.php
msgid "Poll Interval (seconds)"
msgstr "Abfrageintervall (Sekunden)"

#: lib/Settings.php
msgid "Target fleet polling interval in seconds for Little's Law concurrency sizing."
msgstr "Ziel-Abfrageintervall der Flotte in Sekunden für die Parallelitätsdimensionierung nach Little's Law."

#: lib/Settings.php
msgid "Connect Timeout (seconds)"
msgstr "Verbindungs-Zeitüberschreitung (Sekunden)"

#: lib/Settings.php
msgid "Maximum TCP/TLS connect duration per WordPress probe (1-15s)."
msgstr "Maximale TCP/TLS-Verbindungsdauer pro WordPress-Prüfung (1-15s)."

#: lib/Settings.php
msgid "Read Timeout (seconds)"
msgstr "Lese-Zeitüberschreitung (Sekunden)"

#: lib/Settings.php
msgid "Maximum total HTTP read duration per WordPress probe (1-60s)."
msgstr "Maximale gesamte HTTP-Lesedauer pro WordPress-Prüfung (1-60s)."

#: lib/Settings.php
msgid "Max Response Size (bytes)"
msgstr "Maximale Antwortgröße (Bytes)"

#: lib/Settings.php
msgid "Hard byte ceiling per HTTP response (capped at 2097152 bytes / 2 MiB)."
msgstr "Feste Byte-Obergrenze pro HTTP-Antwort (begrenzt auf 2097152 Bytes / 2 MiB)."

#: lib/Settings.php
msgid "CoDel Target Standing Delay (ms)"
msgstr "CoDel-Zielwert für stehende Verzögerung (ms)"

#: lib/Settings.php
msgid "Queue standing-delay target in milliseconds before adaptive concurrency backs off."
msgstr "Zielwert für die stehende Warteschlangenverzögerung in Millisekunden, bevor die adaptive Parallelität reduziert wird."

#: lib/Settings.php
msgid "Minimum Concurrency"
msgstr "Minimale Parallelität"

#: lib/Settings.php
msgid "Lower bound on concurrent WordPress probe workers per collector shard."
msgstr "Untergrenze für parallele WordPress-Prüfprozesse pro Collector-Shard."

#: lib/Settings.php
msgid "Maximum Concurrency"
msgstr "Maximale Parallelität"

#: lib/Settings.php
msgid "Upper bound on concurrent WordPress probe workers per collector shard."
msgstr "Obergrenze für parallele WordPress-Prüfprozesse pro Collector-Shard."

#: lib/Settings.php
msgid "HTTP User-Agent"
msgstr "HTTP User-Agent-Header"

#: lib/Settings.php
msgid "User-Agent header sent on read-only REST and Site Health probes."
msgstr "User-Agent-Header, der bei schreibgeschützten REST- und Website-Zustandsprüfungen gesendet wird."

#: lib/Settings.php
msgid "Fleet Health & Thold Thresholds"
msgstr "Flottenzustand & Thold-Schwellenwerte"

#: lib/Settings.php
msgid "Default Apdex T (ms)"
msgstr "Standard-Apdex T (ms)"

#: lib/Settings.php
msgid "Satisfied TTFB threshold T in milliseconds (tolerating threshold is 4T)."
msgstr "Zufriedenstellender TTFB-Schwellenwert T in Millisekunden (Toleranzschwellenwert ist 4T)."

#: lib/Settings.php
msgid "Autoload Bloat Warning (bytes)"
msgstr "Warnung bei Autoload-Aufblähung (Bytes)"

#: lib/Settings.php
msgid "wp_options autoloaded size warning threshold (default 819200 / 800 KiB)."
msgstr "Warnschwellenwert für die automatisch geladene Größe von wp_options (Standard 819200 / 800 KiB)."

#: lib/Settings.php
msgid "Autoload Bloat Critical (bytes)"
msgstr "Kritische Autoload-Aufblähung (Bytes)"

#: lib/Settings.php
msgid "wp_options autoloaded size critical threshold (default 2097152 / 2 MiB)."
msgstr "Kritischer Schwellenwert für die automatisch geladene Größe von wp_options (Standard 2097152 / 2 MiB)."

#: lib/Settings.php
msgid "WP-Cron Lag Warning (seconds)"
msgstr "Warnung bei WP-Cron-Verzögerung (Sekunden)"

#: lib/Settings.php
msgid "Oldest overdue WP-Cron job lag threshold for degraded status."
msgstr "Verzögerungsschwellenwert des ältesten überfälligen WP-Cron-Auftrags für den Status „Beeinträchtigt“."

#: lib/Settings.php
msgid "TLS Expiry Warning (days)"
msgstr "Warnung bei TLS-Ablauf (Tage)"

#: lib/Settings.php
msgid "Days before TLS certificate expiry triggering degraded status."
msgstr "Tage vor Ablauf des TLS-Zertifikats, die den Status „Beeinträchtigt“ auslösen."

#: lib/Settings.php
msgid "TLS Expiry Critical (days)"
msgstr "Kritischer TLS-Ablauf (Tage)"

#: lib/Settings.php
msgid "Days before TLS certificate expiry triggering critical status."
msgstr "Tage vor Ablauf des TLS-Zertifikats, die den Status „Kritisch“ auslösen."

#: lib/Settings.php
msgid "Keep Tables on Uninstall"
msgstr "Tabellen bei Deinstallation behalten"

#: lib/Settings.php
msgid "Preserve plugin_wordpress database tables when uninstalling the plugin."
msgstr "Datenbanktabellen von plugin_wordpress beim Deinstallieren des Plugins beibehalten."

