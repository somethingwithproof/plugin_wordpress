msgstr "Letztes Ergebnis der Testprüfung"

#: lib/Ui/PagesRenderer.php
msgid "Update Drift, Cron Stalls & Autoload Bloat"
msgstr "Update-Abweichungen, Cron-Blockaden & Autoload-Aufblähung"

#: lib/Ui/PagesRenderer.php
