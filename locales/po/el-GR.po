#: lib/Pages.php
msgid "WordPress View"
msgstr "Προβολή WordPress"

#: lib/Pages.php
msgid "WordPress Operator"
msgstr "Χειριστής WordPress"

#: lib/Pages.php
msgid "WordPress Admin"
msgstr "Διαχειριστής WordPress"

#: lib/Pages.php
msgid "WordPress Fleet Overview"
msgstr "Επισκόπηση στόλου WordPress"

#: lib/Pages.php
msgid "WordPress Drift & Probes"
msgstr "Αποκλίσεις και έλεγχοι WordPress"

#: lib/Pages.php
msgid "WordPress Inventory & Vault"
msgstr "Απογραφή και θησαυροφυλάκιο WordPress"

#: lib/Settings.php
msgid "WordPress Fleet Security & Vault"
msgstr "Ασφάλεια στόλου και θησαυροφυλάκιο WordPress"

#: lib/Settings.php
msgid "Vault Keyfile Path"
msgstr "Διαδρομή αρχείου κλειδιού θησαυροφυλακίου"

#: lib/Settings.php
msgid "Absolute path to the external 256-bit AES-GCM keyfile used to encrypt Application Passwords at rest. Never replicated to remote pollers."
msgstr "Απόλυτη διαδρομή προς το εξωτερικό αρχείο κλειδιού 256-bit AES-GCM που χρησιμοποιείται για την κρυπτογράφηση κωδικών εφαρμογών σε ηρεμία. Δεν αναπαράγεται ποτέ σε απομακρυσμένους pollers."

#: lib/Settings.php
msgid "Internal Host Allowlist"
msgstr "Λίστα επιτρεπόμενων εσωτερικών κεντρικών υπολογιστών"

#: lib/Settings.php
msgid "Comma-separated hostnames or wildcard patterns (e.g. *.corp.example) exempt from private-IP SSRF blocking."
msgstr "Ονόματα κεντρικών υπολογιστών ή μοτίβα μπαλαντέρ διαχωρισμένα με κόμμα (π.χ. *.corp.example) που εξαιρούνται από τον αποκλεισμό SSRF ιδιωτικών IP."

#: lib/Settings.php
msgid "Internal CIDR Allowlist"
msgstr "Λίστα επιτρεπόμενων εσωτερικών CIDR"

#: lib/Settings.php
msgid "Comma-separated internal CIDR ranges explicitly permitted by OutboundGuard."
msgstr "Εσωτερικά εύρη CIDR διαχωρισμένα με κόμμα που επιτρέπονται ρητά από το OutboundGuard."

#: lib/Settings.php
msgid "Outbound Client & Adaptive Poller Sizing"
msgstr "Εξερχόμενος πελάτης και προσαρμοστική διαστασιολόγηση poller"

#: lib/Settings.php
msgid "Poll Interval (seconds)"
msgstr "Διάστημα ελέγχου (δευτερόλεπτα)"

#: lib/Settings.php
msgid "Target fleet polling interval in seconds for Little's Law concurrency sizing."
msgstr "Στοχευμένο διάστημα ελέγχου στόλου σε δευτερόλεπτα για διαστασιολόγηση ταυτοχρονισμού βάσει Little's Law."

#: lib/Settings.php
msgid "Connect Timeout (seconds)"
msgstr "Χρονικό όριο σύνδεσης (δευτερόλεπτα)"

#: lib/Settings.php
msgid "Maximum TCP/TLS connect duration per WordPress probe (1-15s)."
msgstr "Μέγιστη διάρκεια σύνδεσης TCP/TLS ανά έλεγχο WordPress (1-15s)."

#: lib/Settings.php
msgid "Read Timeout (seconds)"
msgstr "Χρονικό όριο ανάγνωσης (δευτερόλεπτα)"

#: lib/Settings.php
msgid "Maximum total HTTP read duration per WordPress probe (1-60s)."
msgstr "Μέγιστη συνολική διάρκεια ανάγνωσης HTTP ανά έλεγχο WordPress (1-60s)."

#: lib/Settings.php
msgid "Max Response Size (bytes)"
msgstr "Μέγιστο μέγεθος απόκρισης (bytes)"

#: lib/Settings.php
msgid "Hard byte ceiling per HTTP response (capped at 2097152 bytes / 2 MiB)."
msgstr "Αυστηρό ανώτατο όριο σε bytes ανά απόκριση HTTP (όριο 2097152 bytes / 2 MiB)."

#: lib/Settings.php
msgid "CoDel Target Standing Delay (ms)"
msgstr "Στοχευμένη μόνιμη καθυστέρηση CoDel (ms)"

#: lib/Settings.php
msgid "Queue standing-delay target in milliseconds before adaptive concurrency backs off."
msgstr "Στόχος μόνιμης καθυστέρησης ουράς σε χιλιοστά του δευτερολέπτου πριν μειωθεί ο προσαρμοστικός ταυτοχρονισμός."

#: lib/Settings.php
msgid "Minimum Concurrency"
msgstr "Ελάχιστος ταυτοχρονισμός"

#: lib/Settings.php
msgid "Lower bound on concurrent WordPress probe workers per collector shard."
msgstr "Κατώτατο όριο ταυτόχρονων διεργασιών ελέγχου WordPress ανά τμήμα συλλέκτη."

#: lib/Settings.php
msgid "Maximum Concurrency"
msgstr "Μέγιστος ταυτοχρονισμός"

#: lib/Settings.php
msgid "Upper bound on concurrent WordPress probe workers per collector shard."
msgstr "Ανώτατο όριο ταυτόχρονων διεργασιών ελέγχου WordPress ανά τμήμα συλλέκτη."

#: lib/Settings.php
msgid "HTTP User-Agent"
msgstr "Κεφαλίδα HTTP User-Agent"

#: lib/Settings.php
msgid "User-Agent header sent on read-only REST and Site Health probes."
msgstr "Κεφαλίδα User-Agent που αποστέλλεται σε ελέγχους REST και υγείας ιστότοπου μόνο για ανάγνωση."

#: lib/Settings.php
msgid "Fleet Health & Thold Thresholds"
msgstr "Υγεία στόλου και όρια Thold"

#: lib/Settings.php
msgid "Default Apdex T (ms)"
msgstr "Προεπιλεγμένο Apdex T (ms)"

#: lib/Settings.php
msgid "Satisfied TTFB threshold T in milliseconds (tolerating threshold is 4T)."
msgstr "Ικανοποιητικό όριο TTFB T σε χιλιοστά του δευτερολέπτου (το όριο ανοχής είναι 4T)."

#: lib/Settings.php
msgid "Autoload Bloat Warning (bytes)"
msgstr "Προειδοποίηση διόγκωσης αυτόματης φόρτωσης (bytes)"

#: lib/Settings.php
msgid "wp_options autoloaded size warning threshold (default 819200 / 800 KiB)."
msgstr "Όριο προειδοποίησης μεγέθους αυτόματης φόρτωσης του wp_options (προεπιλογή 819200 / 800 KiB)."

#: lib/Settings.php
msgid "Autoload Bloat Critical (bytes)"
msgstr "Κρίσιμη διόγκωση αυτόματης φόρτωσης (bytes)"

#: lib/Settings.php
msgid "wp_options autoloaded size critical threshold (default 2097152 / 2 MiB)."
msgstr "Κρίσιμο όριο μεγέθους αυτόματης φόρτωσης του wp_options (προεπιλογή 2097152 / 2 MiB)."

#: lib/Settings.php
msgid "WP-Cron Lag Warning (seconds)"
msgstr "Προειδοποίηση καθυστέρησης WP-Cron (δευτερόλεπτα)"

#: lib/Settings.php
msgid "Oldest overdue WP-Cron job lag threshold for degraded status."
msgstr "Όριο καθυστέρησης της παλαιότερης εκπρόθεσμης εργασίας WP-Cron για υποβαθμισμένη κατάσταση."

#: lib/Settings.php
msgid "TLS Expiry Warning (days)"
msgstr "Προειδοποίηση λήξης TLS (ημέρες)"

#: lib/Settings.php
msgid "Days before TLS certificate expiry triggering degraded status."
msgstr "Ημέρες πριν από τη λήξη του πιστοποιητικού TLS που ενεργοποιούν υποβαθμισμένη κατάσταση."

#: lib/Settings.php
msgid "TLS Expiry Critical (days)"
msgstr "Κρίσιμη λήξη TLS (ημέρες)"

#: lib/Settings.php
msgid "Days before TLS certificate expiry triggering critical status."
msgstr "Ημέρες πριν από τη λήξη του πιστοποιητικού TLS που ενεργοποιούν κρίσιμη κατάσταση."

#: lib/Settings.php
msgid "Keep Tables on Uninstall"
msgstr "Διατήρηση πινάκων κατά την απεγκατάσταση"

#: lib/Settings.php
msgid "Preserve plugin_wordpress database tables when uninstalling the plugin."
msgstr "Διατήρηση των πινάκων βάσης δεδομένων plugin_wordpress κατά την απεγκατάσταση του προσθέτου."

