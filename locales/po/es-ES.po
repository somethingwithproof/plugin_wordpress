#: lib/Ui/PagesRenderer.php
msgid "Latest Dry-Run Probe Result"
msgstr "Último resultado de la sonda de prueba"

#: lib/Ui/PagesRenderer.php
msgid "Update Drift, Cron Stalls & Autoload Bloat"
msgstr "Desviación de actualizaciones, bloqueos de Cron y sobrecarga de carga automática"

#: lib/Ui/PagesRenderer.php
msgid "Vault Status:"
msgstr "Estado de la bóveda:"

#: lib/Ui/PagesRenderer.php
msgid "Add or Update WordPress Site"
msgstr "Añadir o actualizar sitio de WordPress"

#: lib/Ui/PagesRenderer.php
msgid "Save Site"
msgstr "Guardar sitio"

#: lib/Ui/PagesRenderer.php
msgid "Configured Fleet Inventory"
msgstr "Inventario de flota configurado"

#: lib/Ui/PagesRenderer.php
