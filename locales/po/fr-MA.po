msgid "Dry-Run Probe Site:"
msgstr "Site de test à blanc :"

#: lib/Ui/PagesRenderer.php
msgid "Run Read-Only Probe"
msgstr "Exécuter une sonde en lecture seule"

#: lib/Ui/PagesRenderer.php
msgid "Latest Dry-Run Probe Result"
msgstr "Dernier résultat de sonde à blanc"

#: lib/Ui/PagesRenderer.php
msgid "Update Drift, Cron Stalls & Autoload Bloat"
msgstr "Dérives de mise à jour, blocages Cron et surcharge du chargement automatique"

#: lib/Ui/PagesRenderer.php
msgid "Vault Status:"
msgstr "Statut du coffre-fort :"

#: lib/Ui/PagesRenderer.php
msgid "Add or Update WordPress Site"
msgstr "Ajouter ou actualiser un site WordPress"

#: lib/Ui/PagesRenderer.php
msgid "Save Site"
msgstr "Sauvegarder le site"

#: lib/Ui/PagesRenderer.php
msgid "Configured Fleet Inventory"
msgstr "Inventaire du parc configuré"

#: lib/Ui/PagesRenderer.php
msgid "Delete"
msgstr "Supprimer"

