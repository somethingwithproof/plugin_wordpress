msgid "WordPress View"
msgstr "Consultation WordPress"

#: lib/Pages.php
msgid "WordPress Operator"
msgstr "Opérateur WordPress"

#: lib/Pages.php
msgid "WordPress Admin"
msgstr "Administrateur WordPress"

#: lib/Pages.php
msgid "WordPress Fleet Overview"
msgstr "Aperçu global du parc WordPress"

#: lib/Pages.php
msgid "WordPress Drift & Probes"
msgstr "Dérives et sondes WordPress"

#: lib/Pages.php
msgid "WordPress Inventory & Vault"
msgstr "Inventaire et coffre-fort WordPress"

#: lib/Settings.php
msgid "WordPress Fleet Security & Vault"
msgstr "Sécurité du parc et coffre-fort WordPress"

#: lib/Settings.php
msgid "Vault Keyfile Path"
msgstr "Chemin du fichier de clé du coffre-fort"

#: lib/Settings.php
msgid "Absolute path to the external 256-bit AES-GCM keyfile used to encrypt Application Passwords at rest. Never replicated to remote pollers."
msgstr "Chemin absolu vers le fichier de clé externe 256-bit AES-GCM utilisé pour chiffrer les mots de passe d'application au repos. N'est jamais répliqué vers les collecteurs distants."

#: lib/Settings.php
msgid "Internal Host Allowlist"
msgstr "Liste blanche des hôtes internes"

#: lib/Settings.php
msgid "Comma-separated hostnames or wildcard patterns (e.g. *.corp.example) exempt from private-IP SSRF blocking."
msgstr "Noms d'hôtes ou motifs génériques séparés par des virgules (ex. *.corp.example) exemptés du blocage SSRF des IP privées."

#: lib/Settings.php
msgid "Internal CIDR Allowlist"
msgstr "Liste blanche CIDR interne"

#: lib/Settings.php
msgid "Comma-separated internal CIDR ranges explicitly permitted by OutboundGuard."
msgstr "Plages CIDR internes séparées par des virgules expressément autorisées par OutboundGuard."

#: lib/Settings.php
msgid "Outbound Client & Adaptive Poller Sizing"
msgstr "Client sortant et dimensionnement adaptatif du collecteur"

#: lib/Settings.php
msgid "Poll Interval (seconds)"
msgstr "Intervalle de collecte (secondes)"

#: lib/Settings.php
msgid "Target fleet polling interval in seconds for Little's Law concurrency sizing."
msgstr "Intervalle cible de collecte du parc en secondes pour le calcul de concurrence selon Little's Law."

#: lib/Settings.php
msgid "Connect Timeout (seconds)"
msgstr "Délai maximal de connexion (secondes)"

#: lib/Settings.php
msgid "Maximum TCP/TLS connect duration per WordPress probe (1-15s)."
msgstr "Durée maximale de connexion TCP/TLS par sonde WordPress (1-15s)."

#: lib/Settings.php
msgid "Read Timeout (seconds)"
msgstr "Délai maximal de lecture (secondes)"

#: lib/Settings.php
msgid "Maximum total HTTP read duration per WordPress probe (1-60s)."
msgstr "Durée maximale totale de lecture HTTP par sonde WordPress (1-60s)."

#: lib/Settings.php
msgid "Max Response Size (bytes)"
msgstr "Taille maximale de réponse (octets)"

#: lib/Settings.php
msgid "Hard byte ceiling per HTTP response (capped at 2097152 bytes / 2 MiB)."
msgstr "Plafond strict en octets par réponse HTTP (plafonné à 2097152 octets / 2 MiB)."

#: lib/Settings.php
msgid "CoDel Target Standing Delay (ms)"
msgstr "Délai permanent cible CoDel (ms)"

#: lib/Settings.php
msgid "Queue standing-delay target in milliseconds before adaptive concurrency backs off."
msgstr "Délai permanent cible en file d'attente en millisecondes avant le repli de la concurrence adaptative."

#: lib/Settings.php
msgid "Minimum Concurrency"
msgstr "Concurrence minimale"

#: lib/Settings.php
msgid "Lower bound on concurrent WordPress probe workers per collector shard."
msgstr "Borne inférieure du nombre d'agents de sonde WordPress concurrents par partition de collecteur."

#: lib/Settings.php
msgid "Maximum Concurrency"
msgstr "Concurrence maximale"

#: lib/Settings.php
msgid "Upper bound on concurrent WordPress probe workers per collector shard."
msgstr "Borne supérieure du nombre d'agents de sonde WordPress concurrents par partition de collecteur."

#: lib/Settings.php
msgid "HTTP User-Agent"
msgstr "En-tête HTTP User-Agent"

#: lib/Settings.php
msgid "User-Agent header sent on read-only REST and Site Health probes."
msgstr "En-tête User-Agent transmis lors des sondes REST et Santé du site en lecture seule."

#: lib/Settings.php
msgid "Fleet Health & Thold Thresholds"
msgstr "Santé du parc et seuils Thold"

#: lib/Settings.php
msgid "Default Apdex T (ms)"
msgstr "Seuil Apdex T par défaut (ms)"

#: lib/Settings.php
msgid "Satisfied TTFB threshold T in milliseconds (tolerating threshold is 4T)."
msgstr "Seuil TTFB satisfaisant T en millisecondes (le seuil de tolérance est 4T)."

#: lib/Settings.php
msgid "Autoload Bloat Warning (bytes)"
msgstr "Alerte de surcharge du chargement automatique (octets)"

#: lib/Settings.php
msgid "wp_options autoloaded size warning threshold (default 819200 / 800 KiB)."
msgstr "Seuil d'alerte de la taille chargée automatiquement dans wp_options (par défaut 819200 / 800 KiB)."

#: lib/Settings.php
msgid "Autoload Bloat Critical (bytes)"
msgstr "Seuil critique de surcharge du chargement automatique (octets)"

#: lib/Settings.php
msgid "wp_options autoloaded size critical threshold (default 2097152 / 2 MiB)."
msgstr "Seuil critique de la taille chargée automatiquement dans wp_options (par défaut 2097152 / 2 MiB)."

#: lib/Settings.php
msgid "WP-Cron Lag Warning (seconds)"
msgstr "Alerte de retard WP-Cron (secondes)"

#: lib/Settings.php
msgid "Oldest overdue WP-Cron job lag threshold for degraded status."
msgstr "Seuil de retard de la plus ancienne tâche WP-Cron échue pour l'état dégradé."

#: lib/Settings.php
msgid "TLS Expiry Warning (days)"
msgstr "Alerte d'expiration TLS (jours)"

#: lib/Settings.php
msgid "Days before TLS certificate expiry triggering degraded status."
msgstr "Jours restants avant l'expiration du certificat TLS déclenchant l'état dégradé."

#: lib/Settings.php
msgid "TLS Expiry Critical (days)"
msgstr "Expiration critique TLS (jours)"

#: lib/Settings.php
msgid "Days before TLS certificate expiry triggering critical status."
msgstr "Jours restants avant l'expiration du certificat TLS déclenchant l'état critique."

#: lib/Settings.php
msgid "Keep Tables on Uninstall"
msgstr "Conserver les tables lors de la désinstallation"

#: lib/Settings.php
msgid "Preserve plugin_wordpress database tables when uninstalling the plugin."
msgstr "Conserver les tables de base de données plugin_wordpress lors de la désinstallation du module."

