msgstr "Lancer une sonde en lecture seule"

#: lib/Ui/PagesRenderer.php
msgid "Latest Dry-Run Probe Result"
msgstr "Dernier résultat de sonde à blanc"

#: lib/Ui/PagesRenderer.php
msgid "Update Drift, Cron Stalls & Autoload Bloat"
msgstr "Écarts de mise à jour, blocages Cron et gonflement du chargement automatique"

#: lib/Ui/PagesRenderer.php
msgid "Vault Status:"
msgstr "État du coffre sécurisé :"

#: lib/Ui/PagesRenderer.php
msgid "Add or Update WordPress Site"
msgstr "Ajouter ou mettre à jour un site WordPress"

#: lib/Ui/PagesRenderer.php
msgid "Save Site"
msgstr "Enregistrer le site"

#: lib/Ui/PagesRenderer.php
msgid "Configured Fleet Inventory"
msgstr "Inventaire de la flotte configurée"

#: lib/Ui/PagesRenderer.php
