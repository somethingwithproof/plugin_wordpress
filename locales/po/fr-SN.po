msgstr "Administrateur WordPress"

#: lib/Pages.php
msgid "WordPress Fleet Overview"
msgstr "Vue d'ensemble de la flotte WordPress"

#: lib/Pages.php
msgid "WordPress Drift & Probes"
msgstr "Écarts et sondes WordPress"

#: lib/Pages.php
msgid "WordPress Inventory & Vault"
msgstr "Inventaire et coffre sécurisé WordPress"

#: lib/Settings.php
msgid "WordPress Fleet Security & Vault"
msgstr "Sécurité de la flotte et coffre sécurisé WordPress"

#: lib/Settings.php
msgid "Vault Keyfile Path"
msgstr "Chemin du fichier de clé du coffre sécurisé"

#: lib/Settings.php
msgid "Absolute path to the external 256-bit AES-GCM keyfile used to encrypt Application Passwords at rest. Never replicated to remote pollers."
msgstr "Chemin absolu vers le fichier de clé externe 256-bit AES-GCM servant à chiffrer les mots de passe d'application au repos. Jamais répliqué sur les sondeurs distants."

#: lib/Settings.php
msgid "Internal Host Allowlist"
msgstr "Liste des hôtes internes autorisés"

#: lib/Settings.php
msgid "Comma-separated hostnames or wildcard patterns (e.g. *.corp.example) exempt from private-IP SSRF blocking."
msgstr "Noms d'hôtes ou motifs génériques séparés par des virgules (ex. *.corp.example) exemptés du blocage SSRF sur adresses IP privées."

#: lib/Settings.php
msgid "Internal CIDR Allowlist"
msgstr "Liste des plages CIDR internes autorisées"

#: lib/Settings.php
msgid "Comma-separated internal CIDR ranges explicitly permitted by OutboundGuard."
msgstr "Plages CIDR internes séparées par des virgules autorisées explicitement par OutboundGuard."

#: lib/Settings.php
msgid "Outbound Client & Adaptive Poller Sizing"
msgstr "Client sortant et dimensionnement adaptatif du sondeur"

#: lib/Settings.php
msgid "Poll Interval (seconds)"
msgstr "Intervalle d'interrogation (secondes)"

#: lib/Settings.php
msgid "Target fleet polling interval in seconds for Little's Law concurrency sizing."
msgstr "Intervalle cible d'interrogation de la flotte en secondes pour le dimensionnement de concurrence selon Little's Law."

#: lib/Settings.php
msgid "Connect Timeout (seconds)"
msgstr "Délai d'expiration de connexion (secondes)"

#: lib/Settings.php
msgid "Maximum TCP/TLS connect duration per WordPress probe (1-15s)."
msgstr "Durée maximale d'établissement TCP/TLS par sonde WordPress (1-15s)."

#: lib/Settings.php
msgid "Read Timeout (seconds)"
msgstr "Délai d'expiration de lecture (secondes)"

#: lib/Settings.php
msgid "Maximum total HTTP read duration per WordPress probe (1-60s)."
msgstr "Durée maximale totale de lecture HTTP par sonde WordPress (1-60s)."

#: lib/Settings.php
msgid "Max Response Size (bytes)"
msgstr "Taille maximale de réponse (octets)"

#: lib/Settings.php
msgid "Hard byte ceiling per HTTP response (capped at 2097152 bytes / 2 MiB)."
msgstr "Plafond ferme en octets par réponse HTTP (limité à 2097152 octets / 2 MiB)."

#: lib/Settings.php
msgid "CoDel Target Standing Delay (ms)"
msgstr "Délai permanent cible CoDel (ms)"

#: lib/Settings.php
msgid "Queue standing-delay target in milliseconds before adaptive concurrency backs off."
msgstr "Objectif de délai permanent en file d'attente en millisecondes avant diminution de la concurrence adaptative."

#: lib/Settings.php
msgid "Minimum Concurrency"
msgstr "Concurrence minimale"

#: lib/Settings.php
msgid "Lower bound on concurrent WordPress probe workers per collector shard."
msgstr "Limite minimale d'exécuteurs de sonde WordPress simultanés par segment de collecteur."

#: lib/Settings.php
msgid "Maximum Concurrency"
msgstr "Concurrence maximale"

#: lib/Settings.php
msgid "Upper bound on concurrent WordPress probe workers per collector shard."
msgstr "Limite maximale d'exécuteurs de sonde WordPress simultanés par segment de collecteur."

#: lib/Settings.php
msgid "HTTP User-Agent"
msgstr "En-tête HTTP User-Agent"

#: lib/Settings.php
msgid "User-Agent header sent on read-only REST and Site Health probes."
msgstr "En-tête User-Agent envoyé pour les sondes REST et Santé du site en lecture seule."

#: lib/Settings.php
msgid "Fleet Health & Thold Thresholds"
msgstr "Santé de la flotte et seuils Thold"

#: lib/Settings.php
msgid "Default Apdex T (ms)"
msgstr "Apdex T par défaut (ms)"

#: lib/Settings.php
msgid "Satisfied TTFB threshold T in milliseconds (tolerating threshold is 4T)."
msgstr "Seuil TTFB satisfaisant T en millisecondes (le seuil toléré est 4T)."

#: lib/Settings.php
msgid "Autoload Bloat Warning (bytes)"
msgstr "Avertissement de gonflement du chargement automatique (octets)"

#: lib/Settings.php
msgid "wp_options autoloaded size warning threshold (default 819200 / 800 KiB)."
msgstr "Seuil d'avertissement de la taille chargée automatiquement dans wp_options (par défaut 819200 / 800 KiB)."

#: lib/Settings.php
msgid "Autoload Bloat Critical (bytes)"
msgstr "Seuil critique de gonflement du chargement automatique (octets)"

#: lib/Settings.php
msgid "wp_options autoloaded size critical threshold (default 2097152 / 2 MiB)."
msgstr "Seuil critique de la taille chargée automatiquement dans wp_options (par défaut 2097152 / 2 MiB)."

#: lib/Settings.php
msgid "WP-Cron Lag Warning (seconds)"
msgstr "Avertissement de retard WP-Cron (secondes)"

#: lib/Settings.php
msgid "Oldest overdue WP-Cron job lag threshold for degraded status."
msgstr "Seuil de retard de la tâche WP-Cron la plus ancienne en retard pour passer en état dégradé."

#: lib/Settings.php
msgid "TLS Expiry Warning (days)"
msgstr "Avertissement d'expiration TLS (jours)"

#: lib/Settings.php
msgid "Days before TLS certificate expiry triggering degraded status."
msgstr "Nombre de jours avant expiration du certificat TLS déclenchant l'état dégradé."

#: lib/Settings.php
msgid "TLS Expiry Critical (days)"
msgstr "Expiration critique TLS (jours)"

#: lib/Settings.php
msgid "Days before TLS certificate expiry triggering critical status."
msgstr "Nombre de jours avant expiration du certificat TLS déclenchant l'état critique."

#: lib/Settings.php
msgid "Keep Tables on Uninstall"
msgstr "Conserver les tables à la désinstallation"

#: lib/Settings.php
msgid "Preserve plugin_wordpress database tables when uninstalling the plugin."
msgstr "Préserver les tables de base de données plugin_wordpress lors de la désinstallation de l'extension."

