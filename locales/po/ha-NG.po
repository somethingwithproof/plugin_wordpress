msgid "Saved WordPress site inventory entry."
msgstr "An ajiye shigarwar jerin shafin WordPress."

#: wordpress_admin.php
msgid "Encrypted Application Password stored in local AES-256-GCM vault."
msgstr "An adana ɓoyayyiyar kalmar sirrin manhaja a cikin ma'ajiyar sirri ta AES-256-GCM ta gida."

#: wordpress_admin.php
msgid "Deleted WordPress site and associated local vault secret."
msgstr "An goge shafin WordPress da sirrin ma'ajiyar gida da ke da alaƙa da shi."

#: wordpress_admin.php
