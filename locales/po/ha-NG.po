msgstr "Jerin WordPress, bayanan shiga na ma'ajiyar sirri da rarraba mai tattara bayanai (Mai kula)"

#: wordpress_operator.php
msgid "Select a site to probe."
msgstr "Zaɓi shafin da za a bincika."

#: wordpress_operator.php
msgid "Unknown WordPress site slug."
msgstr "Sunan alamar shafin WordPress da ba a sani ba."

#: wordpress_operator.php
msgid "Completed read-only dry-run probe."
msgstr "An kammala binciken gwaji na karatu kaɗai."

#: wordpress_operator.php
msgid "Unsupported operator action."
msgstr "Aikin mai sarrafawa da ba a tallafawa ba."

#: wordpress_operator.php
msgid "WordPress Drift, Site Health, Cron & Dry-Run Probes (Operator)"
msgstr "Karkacewar WordPress, lafiyar shafi, Cron da binciken gwaji (Mai sarrafawa)"

