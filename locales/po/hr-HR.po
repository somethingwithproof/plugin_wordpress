msgstr "Web-mjesto za probnu sondu:"

#: lib/Ui/PagesRenderer.php
msgid "Run Read-Only Probe"
msgstr "Pokreni sondu samo za čitanje"

#: lib/Ui/PagesRenderer.php
msgid "Latest Dry-Run Probe Result"
msgstr "Najnoviji rezultat probne sonde"

#: lib/Ui/PagesRenderer.php
msgid "Update Drift, Cron Stalls & Autoload Bloat"
msgstr "Odstupanja ažuriranja, zastoji Crona i prekomjerni autoload"

#: lib/Ui/PagesRenderer.php
msgid "Vault Status:"
msgstr "Status trezora:"

#: lib/Ui/PagesRenderer.php
