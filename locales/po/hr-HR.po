#: lib/Settings.php
msgid "WordPress Fleet Security & Vault"
msgstr "Sigurnost WordPress flote i trezor"

#: lib/Settings.php
msgid "Vault Keyfile Path"
msgstr "Putanja datoteke ključa trezora"

#: lib/Settings.php
msgid "Absolute path to the external 256-bit AES-GCM keyfile used to encrypt Application Passwords at rest. Never replicated to remote pollers."
msgstr "Apsolutna putanja do vanjske 256-bit AES-GCM datoteke ključa koja se koristi za šifriranje aplikacijskih lozinki u mirovanju. Nikada se ne replicira na udaljene polere."

#: lib/Settings.php
msgid "Internal Host Allowlist"
msgstr "Popis dopuštenih internih poslužitelja"

#: lib/Settings.php
msgid "Comma-separated hostnames or wildcard patterns (e.g. *.corp.example) exempt from private-IP SSRF blocking."
msgstr "Nazivi poslužitelja ili zamjenski obrasci odvojeni zarezom (npr. *.corp.example) izuzeti od blokiranja SSRF-a za privatne IP adrese."

#: lib/Settings.php
msgid "Internal CIDR Allowlist"
msgstr "Popis dopuštenih internih CIDR raspona"

#: lib/Settings.php
msgid "Comma-separated internal CIDR ranges explicitly permitted by OutboundGuard."
msgstr "Interni CIDR rasponi odvojeni zarezom koje OutboundGuard izričito dopušta."

#: lib/Settings.php
msgid "Outbound Client & Adaptive Poller Sizing"
msgstr "Izlazni klijent i prilagodljivo dimenzioniranje polera"

#: lib/Settings.php
msgid "Poll Interval (seconds)"
msgstr "Interval ispitivanja (sekunde)"

#: lib/Settings.php
msgid "Target fleet polling interval in seconds for Little's Law concurrency sizing."
msgstr "Ciljni interval ispitivanja flote u sekundama za dimenzioniranje istodobnosti prema Little's Law."

#: lib/Settings.php
msgid "Connect Timeout (seconds)"
msgstr "Istek vremena povezivanja (sekunde)"

#: lib/Settings.php
msgid "Maximum TCP/TLS connect duration per WordPress probe (1-15s)."
msgstr "Maksimalno trajanje TCP/TLS povezivanja po WordPress sondi (1-15s)."

#: lib/Settings.php
msgid "Read Timeout (seconds)"
msgstr "Istek vremena čitanja (sekunde)"

#: lib/Settings.php
msgid "Maximum total HTTP read duration per WordPress probe (1-60s)."
msgstr "Maksimalno ukupno trajanje HTTP čitanja po WordPress sondi (1-60s)."

#: lib/Settings.php
msgid "Max Response Size (bytes)"
msgstr "Maksimalna veličina odgovora (bajtovi)"

#: lib/Settings.php
msgid "Hard byte ceiling per HTTP response (capped at 2097152 bytes / 2 MiB)."
msgstr "Strogo ograničenje bajtova po HTTP odgovoru (ograničeno na 2097152 bajtova / 2 MiB)."

#: lib/Settings.php
msgid "CoDel Target Standing Delay (ms)"
msgstr "CoDel ciljno trajno kašnjenje (ms)"

#: lib/Settings.php
msgid "Queue standing-delay target in milliseconds before adaptive concurrency backs off."
msgstr "Ciljno trajno kašnjenje reda čekanja u milisekundama prije nego što prilagodljiva istodobnost smanji opterećenje."

#: lib/Settings.php
msgid "Minimum Concurrency"
msgstr "Minimalna istodobnost"

#: lib/Settings.php
msgid "Lower bound on concurrent WordPress probe workers per collector shard."
msgstr "Donja granica istodobnih radnih procesa WordPress sonde po particiji prikupljača."

#: lib/Settings.php
msgid "Maximum Concurrency"
msgstr "Maksimalna istodobnost"

#: lib/Settings.php
msgid "Upper bound on concurrent WordPress probe workers per collector shard."
msgstr "Gornja granica istodobnih radnih procesa WordPress sonde po particiji prikupljača."

#: lib/Settings.php
msgid "HTTP User-Agent"
msgstr "HTTP User-Agent"

#: lib/Settings.php
msgid "User-Agent header sent on read-only REST and Site Health probes."
msgstr "Zaglavlje User-Agent poslano u REST i Site Health sondama samo za čitanje."

#: lib/Settings.php
msgid "Fleet Health & Thold Thresholds"
msgstr "Zdravlje flote i pragovi Thold"

#: lib/Settings.php
msgid "Default Apdex T (ms)"
msgstr "Zadani Apdex T (ms)"

#: lib/Settings.php
msgid "Satisfied TTFB threshold T in milliseconds (tolerating threshold is 4T)."
msgstr "Zadovoljavajući TTFB prag T u milisekundama (prag tolerancije je 4T)."

#: lib/Settings.php
msgid "Autoload Bloat Warning (bytes)"
msgstr "Upozorenje za prekomjerni autoload (bajtovi)"

#: lib/Settings.php
msgid "wp_options autoloaded size warning threshold (default 819200 / 800 KiB)."
msgstr "Prag upozorenja za veličinu automatskog učitavanja wp_options (zadano 819200 / 800 KiB)."

#: lib/Settings.php
msgid "Autoload Bloat Critical (bytes)"
msgstr "Kritični prag za prekomjerni autoload (bajtovi)"

#: lib/Settings.php
msgid "wp_options autoloaded size critical threshold (default 2097152 / 2 MiB)."
msgstr "Kritični prag za veličinu automatskog učitavanja wp_options (zadano 2097152 / 2 MiB)."

#: lib/Settings.php
msgid "WP-Cron Lag Warning (seconds)"
msgstr "Upozorenje za kašnjenje WP-Cron (sekunde)"

#: lib/Settings.php
msgid "Oldest overdue WP-Cron job lag threshold for degraded status."
msgstr "Prag kašnjenja najstarijeg zakašnjelog WP-Cron zadatka za degradirani status."

#: lib/Settings.php
msgid "TLS Expiry Warning (days)"
msgstr "Upozorenje za istek TLS-a (dani)"

#: lib/Settings.php
msgid "Days before TLS certificate expiry triggering degraded status."
msgstr "Broj dana prije isteka TLS certifikata koji pokreće degradirani status."

#: lib/Settings.php
msgid "TLS Expiry Critical (days)"
msgstr "Kritično upozorenje za istek TLS-a (dani)"

#: lib/Settings.php
msgid "Days before TLS certificate expiry triggering critical status."
msgstr "Broj dana prije isteka TLS certifikata koji pokreće kritični status."

#: lib/Settings.php
msgid "Keep Tables on Uninstall"
msgstr "Zadrži tablice pri deinstalaciji"

#: lib/Settings.php
msgid "Preserve plugin_wordpress database tables when uninstalling the plugin."
msgstr "Sačuvaj tablice baze podataka plugin_wordpress prilikom deinstalacije dodatka."

