#: lib/Settings.php
msgid "WordPress Fleet Security & Vault"
msgstr "Nchekwa Ọtụtụ Saịtị na Ụlọ Nchekwa WordPress"

#: lib/Settings.php
msgid "Vault Keyfile Path"
msgstr "Ụzọ Faịlụ Igodo Ụlọ Nchekwa"

#: lib/Settings.php
msgid "Absolute path to the external 256-bit AES-GCM keyfile used to encrypt Application Passwords at rest. Never replicated to remote pollers."
msgstr "Ụzọ zuru oke na faịlụ igodo 256-bit AES-GCM nke mpụga eji ezobe Okwuntughe Ngwa n'ebe nchekwa. A naghị edepụtaghachi ya na polers dị anya."

#: lib/Settings.php
msgid "Internal Host Allowlist"
msgstr "Ndepụta Nnabata Host Ime Ụlọ"

#: lib/Settings.php
msgid "Comma-separated hostnames or wildcard patterns (e.g. *.corp.example) exempt from private-IP SSRF blocking."
msgstr "Aha host ma ọ bụ usoro wildcard kewara site na rikọm (dịka *.corp.example) ndị a napụrụ na mgbochi SSRF nke IP nzuzo."

#: lib/Settings.php
msgid "Internal CIDR Allowlist"
msgstr "Ndepụta Nnabata CIDR Ime Ụlọ"

#: lib/Settings.php
msgid "Comma-separated internal CIDR ranges explicitly permitted by OutboundGuard."
msgstr "Oke CIDR ime ụlọ kewara site na rikọm nke OutboundGuard kwadoro n'ụzọ doro anya."

#: lib/Settings.php
msgid "Outbound Client & Adaptive Poller Sizing"
msgstr "Onye Ahịa Mpụga na Nhazi Ogo Poler Na-agbanwe"

#: lib/Settings.php
msgid "Poll Interval (seconds)"
msgstr "Oge Nyocha (sekọnd)"

#: lib/Settings.php
msgid "Target fleet polling interval in seconds for Little's Law concurrency sizing."
msgstr "Oge nyocha ebumnuche nke ọtụtụ saịtị na sekọnd maka nhazi ọnụọgụ ọrụ otu oge nke Little's Law."

#: lib/Settings.php
msgid "Connect Timeout (seconds)"
msgstr "Oge Njikọ Gwụrụ (sekọnd)"

#: lib/Settings.php
msgid "Maximum TCP/TLS connect duration per WordPress probe (1-15s)."
msgstr "Oke oge njikọ TCP/TLS maka nyocha WordPress ọ bụla (1-15s)."

#: lib/Settings.php
msgid "Read Timeout (seconds)"
msgstr "Oge Ọgụgụ Gwụrụ (sekọnd)"

#: lib/Settings.php
msgid "Maximum total HTTP read duration per WordPress probe (1-60s)."
msgstr "Oke mkpokọta oge ọgụgụ HTTP maka nyocha WordPress ọ bụla (1-60s)."

#: lib/Settings.php
msgid "Max Response Size (bytes)"
msgstr "Oke Nha Nzaghachi (bytes)"

#: lib/Settings.php
msgid "Hard byte ceiling per HTTP response (capped at 2097152 bytes / 2 MiB)."
msgstr "Oke siri ike nke bytes maka nzaghachi HTTP ọ bụla (ejedebere na 2097152 bytes / 2 MiB)."

#: lib/Settings.php
msgid "CoDel Target Standing Delay (ms)"
msgstr "Oge Nkwụsị Ebumnuche CoDel (ms)"

#: lib/Settings.php
msgid "Queue standing-delay target in milliseconds before adaptive concurrency backs off."
msgstr "Ebumnuche oge nkwụsị n'ahịrị na milisekọnd tupu nhazi ọrụ otu oge na-agbanwe ebelata."

#: lib/Settings.php
msgid "Minimum Concurrency"
msgstr "Ọnụọgụ Ọrụ Otu Oge Kacha Nta"

#: lib/Settings.php
msgid "Lower bound on concurrent WordPress probe workers per collector shard."
msgstr "Oke ala maka ndị ọrụ nyocha WordPress na-arụ ọrụ n'otu oge maka akụkụ onye nchịkọta ọ bụla."

#: lib/Settings.php
msgid "Maximum Concurrency"
msgstr "Ọnụọgụ Ọrụ Otu Oge Kacha Elu"

#: lib/Settings.php
msgid "Upper bound on concurrent WordPress probe workers per collector shard."
msgstr "Oke elu maka ndị ọrụ nyocha WordPress na-arụ ọrụ n'otu oge maka akụkụ onye nchịkọta ọ bụla."

#: lib/Settings.php
msgid "HTTP User-Agent"
msgstr "HTTP User-Agent"

#: lib/Settings.php
msgid "User-Agent header sent on read-only REST and Site Health probes."
msgstr "Isiokwu User-Agent ezitere na nyocha REST na Ahụike Saịtị maka naanị ọgụgụ."

#: lib/Settings.php
msgid "Fleet Health & Thold Thresholds"
msgstr "Ahụike Ọtụtụ Saịtị na Oke Thold"

#: lib/Settings.php
msgid "Default Apdex T (ms)"
msgstr "Apdex T Nke Ndiịzizi (ms)"

#: lib/Settings.php
msgid "Satisfied TTFB threshold T in milliseconds (tolerating threshold is 4T)."
msgstr "Oke TTFB afọ ojuju T na milisekọnd (oke ndidi bụ 4T)."

#: lib/Settings.php
msgid "Autoload Bloat Warning (bytes)"
msgstr "Ịdọ Aka Ná Ntị Mbuba Autoload (bytes)"

#: lib/Settings.php
msgid "wp_options autoloaded size warning threshold (default 819200 / 800 KiB)."
msgstr "Oke ịdọ aka ná ntị maka nha autoload nke wp_options (ndabara 819200 / 800 KiB)."

#: lib/Settings.php
msgid "Autoload Bloat Critical (bytes)"
msgstr "Oke Dị Mkpa nke Mbuba Autoload (bytes)"

#: lib/Settings.php
msgid "wp_options autoloaded size critical threshold (default 2097152 / 2 MiB)."
msgstr "Oke dị mkpa maka nha autoload nke wp_options (ndabara 2097152 / 2 MiB)."

#: lib/Settings.php
msgid "WP-Cron Lag Warning (seconds)"
msgstr "Ịdọ Aka Ná Ntị Nkwụsị WP-Cron (sekọnd)"

#: lib/Settings.php
msgid "Oldest overdue WP-Cron job lag threshold for degraded status."
msgstr "Oke nkwụsị nke ọrụ WP-Cron kacha gafe oge maka ọnọdụ dara ada."

#: lib/Settings.php
msgid "TLS Expiry Warning (days)"
msgstr "Ịdọ Aka Ná Ntị Mbibi Oge TLS (ụbọchị)"

#: lib/Settings.php
msgid "Days before TLS certificate expiry triggering degraded status."
msgstr "Ụbọchị tupu asambodo TLS agwụ nke na-akpalite ọnọdụ dara ada."

#: lib/Settings.php
msgid "TLS Expiry Critical (days)"
msgstr "Oke Dị Mkpa nke Mbibi Oge TLS (ụbọchị)"

#: lib/Settings.php
msgid "Days before TLS certificate expiry triggering critical status."
msgstr "Ụbọchị tupu asambodo TLS agwụ nke na-akpalite ọnọdụ dị njọ."

#: lib/Settings.php
msgid "Keep Tables on Uninstall"
msgstr "Debe Tebụl Mgbe A Na-ewepụ"

#: lib/Settings.php
msgid "Preserve plugin_wordpress database tables when uninstalling the plugin."
msgstr "Chekwaa tebụl nchekwa data plugin_wordpress mgbe a na-ewepụ plọgin ahụ."

