#: lib/Pages.php
msgid "WordPress View"
msgstr "Vista WordPress"

#: lib/Pages.php
msgid "WordPress Operator"
msgstr "Operatore WordPress"

#: lib/Pages.php
msgid "WordPress Admin"
msgstr "Amministratore WordPress"

#: lib/Pages.php
msgid "WordPress Fleet Overview"
msgstr "Panoramica flotta WordPress"

#: lib/Pages.php
msgid "WordPress Drift & Probes"
msgstr "Deriva e sonde WordPress"

#: lib/Pages.php
msgid "WordPress Inventory & Vault"
msgstr "Inventario e vault WordPress"

#: lib/Settings.php
msgid "WordPress Fleet Security & Vault"
msgstr "Sicurezza flotta WordPress e vault"

#: lib/Settings.php
msgid "Vault Keyfile Path"
msgstr "Percorso del file chiave del vault"

#: lib/Settings.php
msgid "Absolute path to the external 256-bit AES-GCM keyfile used to encrypt Application Passwords at rest. Never replicated to remote pollers."
msgstr "Percorso assoluto del file chiave esterno 256-bit AES-GCM utilizzato per cifrare le password delle applicazioni a riposo. Non viene mai replicato sui poller remoti."

#: lib/Settings.php
msgid "Internal Host Allowlist"
msgstr "Elenco host interni consentiti"

#: lib/Settings.php
msgid "Comma-separated hostnames or wildcard patterns (e.g. *.corp.example) exempt from private-IP SSRF blocking."
msgstr "Nomi host o pattern con caratteri jolly separati da virgola (es. *.corp.example) esenti dal blocco SSRF per IP privati."

#: lib/Settings.php
msgid "Internal CIDR Allowlist"
msgstr "Elenco CIDR interni consentiti"

#: lib/Settings.php
msgid "Comma-separated internal CIDR ranges explicitly permitted by OutboundGuard."
msgstr "Intervalli CIDR interni separati da virgola esplicitamente consentiti da OutboundGuard."

#: lib/Settings.php
msgid "Outbound Client & Adaptive Poller Sizing"
msgstr "Client in uscita e dimensionamento adattivo del poller"

#: lib/Settings.php
msgid "Poll Interval (seconds)"
msgstr "Intervallo di polling (secondi)"

#: lib/Settings.php
msgid "Target fleet polling interval in seconds for Little's Law concurrency sizing."
msgstr "Intervallo di polling target della flotta in secondi per il dimensionamento della concorrenza secondo Little's Law."

#: lib/Settings.php
msgid "Connect Timeout (seconds)"
msgstr "Timeout di connessione (secondi)"

#: lib/Settings.php
msgid "Maximum TCP/TLS connect duration per WordPress probe (1-15s)."
msgstr "Durata massima di connessione TCP/TLS per sonda WordPress (1-15s)."

#: lib/Settings.php
msgid "Read Timeout (seconds)"
msgstr "Timeout di lettura (secondi)"

#: lib/Settings.php
msgid "Maximum total HTTP read duration per WordPress probe (1-60s)."
msgstr "Durata totale massima di lettura HTTP per sonda WordPress (1-60s)."

#: lib/Settings.php
msgid "Max Response Size (bytes)"
msgstr "Dimensione massima della risposta (byte)"

#: lib/Settings.php
msgid "Hard byte ceiling per HTTP response (capped at 2097152 bytes / 2 MiB)."
msgstr "Limite rigoroso in byte per risposta HTTP (massimo 2097152 byte / 2 MiB)."

#: lib/Settings.php
msgid "CoDel Target Standing Delay (ms)"
msgstr "Ritardo stazionario target CoDel (ms)"

#: lib/Settings.php
msgid "Queue standing-delay target in milliseconds before adaptive concurrency backs off."
msgstr "Ritardo stazionario target della coda in millisecondi prima della riduzione della concorrenza adattiva."

#: lib/Settings.php
msgid "Minimum Concurrency"
msgstr "Concorrenza minima"

#: lib/Settings.php
msgid "Lower bound on concurrent WordPress probe workers per collector shard."
msgstr "Limite inferiore di worker concorrenti per le sonde WordPress per partizione del raccoglitore."

#: lib/Settings.php
msgid "Maximum Concurrency"
msgstr "Concorrenza massima"

#: lib/Settings.php
msgid "Upper bound on concurrent WordPress probe workers per collector shard."
msgstr "Limite superiore di worker concorrenti per le sonde WordPress per partizione del raccoglitore."

#: lib/Settings.php
msgid "HTTP User-Agent"
msgstr "HTTP User-Agent"

#: lib/Settings.php
msgid "User-Agent header sent on read-only REST and Site Health probes."
msgstr "Intestazione User-Agent inviata nelle sonde REST e Salute del sito in sola lettura."

#: lib/Settings.php
msgid "Fleet Health & Thold Thresholds"
msgstr "Salute della flotta e soglie Thold"

#: lib/Settings.php
msgid "Default Apdex T (ms)"
msgstr "Apdex T predefinito (ms)"

#: lib/Settings.php
msgid "Satisfied TTFB threshold T in milliseconds (tolerating threshold is 4T)."
msgstr "Soglia TTFB soddisfacente T in millisecondi (la soglia tollerabile è 4T)."

#: lib/Settings.php
msgid "Autoload Bloat Warning (bytes)"
msgstr "Avviso sovraccarico autoload (byte)"

#: lib/Settings.php
msgid "wp_options autoloaded size warning threshold (default 819200 / 800 KiB)."
msgstr "Soglia di avviso per la dimensione autoload di wp_options (predefinito 819200 / 800 KiB)."

#: lib/Settings.php
msgid "Autoload Bloat Critical (bytes)"
msgstr "Soglia critica sovraccarico autoload (byte)"

#: lib/Settings.php
msgid "wp_options autoloaded size critical threshold (default 2097152 / 2 MiB)."
msgstr "Soglia critica per la dimensione autoload di wp_options (predefinito 2097152 / 2 MiB)."

#: lib/Settings.php
msgid "WP-Cron Lag Warning (seconds)"
msgstr "Avviso ritardo WP-Cron (secondi)"

#: lib/Settings.php
msgid "Oldest overdue WP-Cron job lag threshold for degraded status."
msgstr "Soglia di ritardo del processo WP-Cron più scaduto per lo stato degradato."

#: lib/Settings.php
msgid "TLS Expiry Warning (days)"
msgstr "Avviso scadenza TLS (giorni)"

#: lib/Settings.php
msgid "Days before TLS certificate expiry triggering degraded status."
msgstr "Giorni prima della scadenza del certificato TLS che attivano lo stato degradato."

#: lib/Settings.php
msgid "TLS Expiry Critical (days)"
msgstr "Soglia critica scadenza TLS (giorni)"

#: lib/Settings.php
msgid "Days before TLS certificate expiry triggering critical status."
msgstr "Giorni prima della scadenza del certificato TLS che attivano lo stato critico."

#: lib/Settings.php
msgid "Keep Tables on Uninstall"
msgstr "Mantieni tabelle alla disinstallazione"

#: lib/Settings.php
msgid "Preserve plugin_wordpress database tables when uninstalling the plugin."
msgstr "Conserva le tabelle del database plugin_wordpress durante la disinstallazione del plugin."

