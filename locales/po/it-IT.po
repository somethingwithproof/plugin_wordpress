msgid "Fleet Health Summary"
msgstr "Riepilogo salute della flotta"

#: lib/Ui/PagesRenderer.php
msgid "MAD Latency Anomalies"
msgstr "Anomalie di latenza MAD"

#: lib/Ui/PagesRenderer.php
msgid "Site Snapshots"
msgstr "Istantanee dei siti"

