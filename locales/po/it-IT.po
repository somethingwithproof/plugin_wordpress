msgid "Dry-Run Probe Site:"
msgstr "Sito per sonda di prova:"

#: lib/Ui/PagesRenderer.php
msgid "Run Read-Only Probe"
msgstr "Esegui sonda in sola lettura"

#: lib/Ui/PagesRenderer.php
msgid "Latest Dry-Run Probe Result"
msgstr "Ultimo risultato della sonda di prova"

#: lib/Ui/PagesRenderer.php
msgid "Update Drift, Cron Stalls & Autoload Bloat"
msgstr "Deriva degli aggiornamenti, blocchi Cron e sovraccarico autoload"

#: lib/Ui/PagesRenderer.php
msgid "Vault Status:"
msgstr "Stato del vault:"

#: lib/Ui/PagesRenderer.php
msgid "Add or Update WordPress Site"
msgstr "Aggiungi o aggiorna sito WordPress"

#: lib/Ui/PagesRenderer.php
msgid "Save Site"
msgstr "Salva sito"

#: lib/Ui/PagesRenderer.php
msgid "Configured Fleet Inventory"
msgstr "Inventario della flotta configurata"

#: lib/Ui/PagesRenderer.php
msgid "Delete"
msgstr "Elimina"

