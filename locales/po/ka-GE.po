#: lib/Settings.php
msgid "Vault Keyfile Path"
msgstr "საცავის გასაღების ფაილის გზა"

#: lib/Settings.php
msgid "Absolute path to the external 256-bit AES-GCM keyfile used to encrypt Application Passwords at rest. Never replicated to remote pollers."
msgstr "აბსოლუტური გზა გარე 256-bit AES-GCM გასაღების ფაილისკენ, რომელიც გამოიყენება აპლიკაციის პაროლების შენახვისას დასაშიფრად. არასოდეს რეპლიცირდება დისტანციურ პოლერებზე."

#: lib/Settings.php
msgid "Internal Host Allowlist"
msgstr "შიდა ჰოსტების დაშვებულთა სია"

#: lib/Settings.php
msgid "Comma-separated hostnames or wildcard patterns (e.g. *.corp.example) exempt from private-IP SSRF blocking."
msgstr "მძიმით გამოყოფილი ჰოსტების სახელები ან შაბლონები (მაგ. *.corp.example), რომლებიც გათავისუფლებულია კერძო IP-ის SSRF დაბლოკვისგან."

#: lib/Settings.php
msgid "Internal CIDR Allowlist"
msgstr "შიდა CIDR დაშვებულთა სია"

#: lib/Settings.php
msgid "Comma-separated internal CIDR ranges explicitly permitted by OutboundGuard."
msgstr "მძიმით გამოყოფილი შიდა CIDR დიაპაზონები, რომლებიც ცალსახად დაშვებულია OutboundGuard-ის მიერ."

#: lib/Settings.php
msgid "Outbound Client & Adaptive Poller Sizing"
msgstr "გამავალი კლიენტი და ადაპტური პოლერის ზომის შერჩევა"

#: lib/Settings.php
msgid "Poll Interval (seconds)"
msgstr "გამოკითხვის ინტერვალი (წამი)"

#: lib/Settings.php
msgid "Target fleet polling interval in seconds for Little's Law concurrency sizing."
msgstr "ფლოტის გამოკითხვის სამიზნე ინტერვალი წამებში Little's Law-ით პარალელურობის გამოსათვლელად."

#: lib/Settings.php
msgid "Connect Timeout (seconds)"
msgstr "დაკავშირების მოლოდინის ვადა (წამი)"

#: lib/Settings.php
msgid "Maximum TCP/TLS connect duration per WordPress probe (1-15s)."
msgstr "TCP/TLS დაკავშირების მაქსიმალური ხანგრძლივობა თითო WordPress ზონდზე (1-15s)."

#: lib/Settings.php
msgid "Read Timeout (seconds)"
msgstr "წაკითხვის მოლოდინის ვადა (წამი)"

#: lib/Settings.php
msgid "Maximum total HTTP read duration per WordPress probe (1-60s)."
msgstr "HTTP წაკითხვის მაქსიმალური ჯამური ხანგრძლივობა თითო WordPress ზონდზე (1-60s)."

#: lib/Settings.php
msgid "Max Response Size (bytes)"
msgstr "პასუხის მაქსიმალური ზომა (ბაიტი)"

#: lib/Settings.php
msgid "Hard byte ceiling per HTTP response (capped at 2097152 bytes / 2 MiB)."
msgstr "მკაცრი ბაიტების ზღვარი თითო HTTP პასუხზე (შეზღუდულია 2097152 ბაიტით / 2 MiB)."

#: lib/Settings.php
msgid "CoDel Target Standing Delay (ms)"
msgstr "CoDel მუდმივი დაყოვნების სამიზნე (ms)"

#: lib/Settings.php
msgid "Queue standing-delay target in milliseconds before adaptive concurrency backs off."
msgstr "რიგის მუდმივი დაყოვნების სამიზნე მილიწამებში, სანამ ადაპტური პარალელურობა შემცირდება."

#: lib/Settings.php
msgid "Minimum Concurrency"
msgstr "მინიმალური პარალელურობა"

#: lib/Settings.php
msgid "Lower bound on concurrent WordPress probe workers per collector shard."
msgstr "პარალელური WordPress ზონდის დამმუშავებლების ქვედა ზღვარი თითო შემგროვებლის შარდზე."

#: lib/Settings.php
msgid "Maximum Concurrency"
msgstr "მაქსიმალური პარალელურობა"

#: lib/Settings.php
msgid "Upper bound on concurrent WordPress probe workers per collector shard."
msgstr "პარალელური WordPress ზონდის დამმუშავებლების ზედა ზღვარი თითო შემგროვებლის შარდზე."

#: lib/Settings.php
msgid "HTTP User-Agent"
msgstr "HTTP User-Agent"

#: lib/Settings.php
msgid "User-Agent header sent on read-only REST and Site Health probes."
msgstr "User-Agent თავსართი, რომელიც იგზავნება მხოლოდ წაკითხვის REST და საიტის ჯანმრთელობის ზონდებზე."

#: lib/Settings.php
msgid "Fleet Health & Thold Thresholds"
msgstr "ფლოტის ჯანმრთელობა და Thold ზღვრები"

#: lib/Settings.php
msgid "Default Apdex T (ms)"
msgstr "ნაგულისხმევი Apdex T (ms)"

#: lib/Settings.php
msgid "Satisfied TTFB threshold T in milliseconds (tolerating threshold is 4T)."
msgstr "დამაკმაყოფილებელი TTFB ზღვარი T მილიწამებში (დასაშვები ზღვარია 4T)."

#: lib/Settings.php
msgid "Autoload Bloat Warning (bytes)"
msgstr "ავტოჩატვირთვის გადატვირთვის გაფრთხილება (ბაიტი)"

#: lib/Settings.php
msgid "wp_options autoloaded size warning threshold (default 819200 / 800 KiB)."
msgstr "wp_options ავტოჩატვირთვის ზომის გაფრთხილების ზღვარი (ნაგულისხმევი 819200 / 800 KiB)."

#: lib/Settings.php
msgid "Autoload Bloat Critical (bytes)"
msgstr "ავტოჩატვირთვის გადატვირთვის კრიტიკული ზღვარი (ბაიტი)"

#: lib/Settings.php
msgid "wp_options autoloaded size critical threshold (default 2097152 / 2 MiB)."
msgstr "wp_options ავტოჩატვირთვის ზომის კრიტიკული ზღვარი (ნაგულისხმევი 2097152 / 2 MiB)."

