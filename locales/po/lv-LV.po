#: lib/Settings.php
msgid "WordPress Fleet Security & Vault"
msgstr "WordPress flotes drošība un glabātuve"

#: lib/Settings.php
msgid "Vault Keyfile Path"
msgstr "Glabātuves atslēgas datnes ceļš"

#: lib/Settings.php
msgid "Absolute path to the external 256-bit AES-GCM keyfile used to encrypt Application Passwords at rest. Never replicated to remote pollers."
msgstr "Absolūtais ceļš uz ārējo 256-bit AES-GCM atslēgas datni, ko izmanto lietotņu paroļu šifrēšanai glabāšanā. Nekad netiek replicēta uz attālajiem aptaujātājiem."

#: lib/Settings.php
msgid "Internal Host Allowlist"
msgstr "Iekšējo resursdatoru atļauju saraksts"

#: lib/Settings.php
msgid "Comma-separated hostnames or wildcard patterns (e.g. *.corp.example) exempt from private-IP SSRF blocking."
msgstr "Ar komatiem atdalīti resursdatoru nosaukumi vai aizstājējzīmju šabloni (piem., *.corp.example), uz kuriem neattiecas privāto IP SSRF bloķēšana."

#: lib/Settings.php
msgid "Internal CIDR Allowlist"
msgstr "Iekšējo CIDR atļauju saraksts"

#: lib/Settings.php
msgid "Comma-separated internal CIDR ranges explicitly permitted by OutboundGuard."
msgstr "Ar komatiem atdalīti iekšējie CIDR diapazoni, kurus tieši atļauj OutboundGuard."

#: lib/Settings.php
msgid "Outbound Client & Adaptive Poller Sizing"
msgstr "Izejošais klients un adaptīvā aptaujātāja mērogošana"

#: lib/Settings.php
msgid "Poll Interval (seconds)"
msgstr "Aptaujas intervāls (sekundes)"

#: lib/Settings.php
msgid "Target fleet polling interval in seconds for Little's Law concurrency sizing."
msgstr "Mērķa flotes aptaujas intervāls sekundēs paralēlisma aprēķinam pēc Little's Law."

#: lib/Settings.php
msgid "Connect Timeout (seconds)"
msgstr "Savienojuma noildze (sekundes)"

#: lib/Settings.php
msgid "Maximum TCP/TLS connect duration per WordPress probe (1-15s)."
msgstr "Maksimālais TCP/TLS savienojuma ilgums vienai WordPress zondei (1-15s)."

#: lib/Settings.php
msgid "Read Timeout (seconds)"
msgstr "Lasīšanas noildze (sekundes)"

#: lib/Settings.php
msgid "Maximum total HTTP read duration per WordPress probe (1-60s)."
msgstr "Maksimālais kopējais HTTP lasīšanas ilgums vienai WordPress zondei (1-60s)."

#: lib/Settings.php
msgid "Max Response Size (bytes)"
msgstr "Maksimālais atbildes lielums (baiti)"

#: lib/Settings.php
msgid "Hard byte ceiling per HTTP response (capped at 2097152 bytes / 2 MiB)."
msgstr "Stingrs baitu griests vienai HTTP atbildei (ierobežots līdz 2097152 baitiem / 2 MiB)."

#: lib/Settings.php
msgid "CoDel Target Standing Delay (ms)"
msgstr "CoDel mērķa pastāvīgā aizkave (ms)"

#: lib/Settings.php
msgid "Queue standing-delay target in milliseconds before adaptive concurrency backs off."
msgstr "Rindas pastāvīgās aizkaves mērķis milisekundēs, pirms adaptīvais paralēlisms samazina slodzi."

#: lib/Settings.php
msgid "Minimum Concurrency"
msgstr "Minimālais paralēlisms"

#: lib/Settings.php
msgid "Lower bound on concurrent WordPress probe workers per collector shard."
msgstr "Apakšējā robeža vienlaicīgu WordPress zondes darbinieku skaitam uz vienu vācēja šardu."

#: lib/Settings.php
msgid "Maximum Concurrency"
msgstr "Maksimālais paralēlisms"

#: lib/Settings.php
msgid "Upper bound on concurrent WordPress probe workers per collector shard."
msgstr "Augšējā robeža vienlaicīgu WordPress zondes darbinieku skaitam uz vienu vācēja šardu."

#: lib/Settings.php
msgid "HTTP User-Agent"
msgstr "HTTP User-Agent"

#: lib/Settings.php
msgid "User-Agent header sent on read-only REST and Site Health probes."
msgstr "User-Agent galvene, kas tiek sūtīta tikai lasāmās REST un vietnes veselības zondēs."

#: lib/Settings.php
msgid "Fleet Health & Thold Thresholds"
msgstr "Flotes veselība un Thold sliekšņi"

#: lib/Settings.php
msgid "Default Apdex T (ms)"
msgstr "Noklusējuma Apdex T (ms)"

#: lib/Settings.php
msgid "Satisfied TTFB threshold T in milliseconds (tolerating threshold is 4T)."
msgstr "Apmierinošais TTFB slieksnis T milisekundēs (pieļaujamais slieksnis ir 4T)."

#: lib/Settings.php
msgid "Autoload Bloat Warning (bytes)"
msgstr "Automātiskās ielādes pārblīvēšanas brīdinājums (baiti)"

#: lib/Settings.php
msgid "wp_options autoloaded size warning threshold (default 819200 / 800 KiB)."
msgstr "wp_options automātiskās ielādes lieluma brīdinājuma slieksnis (noklusējums 819200 / 800 KiB)."

#: lib/Settings.php
msgid "Autoload Bloat Critical (bytes)"
msgstr "Automātiskās ielādes pārblīvēšanas kritiskais slieksnis (baiti)"

#: lib/Settings.php
msgid "wp_options autoloaded size critical threshold (default 2097152 / 2 MiB)."
msgstr "wp_options automātiskās ielādes lieluma kritiskais slieksnis (noklusējums 2097152 / 2 MiB)."

#: lib/Settings.php
msgid "WP-Cron Lag Warning (seconds)"
msgstr "WP-Cron aizkaves brīdinājums (sekundes)"

#: lib/Settings.php
msgid "Oldest overdue WP-Cron job lag threshold for degraded status."
msgstr "Vecākā nokavētā WP-Cron uzdevuma aizkaves slieksnis pasliktināta stāvokļa noteikšanai."

#: lib/Settings.php
msgid "TLS Expiry Warning (days)"
msgstr "TLS termiņa beigšanās brīdinājums (dienas)"

#: lib/Settings.php
msgid "Days before TLS certificate expiry triggering degraded status."
msgstr "Dienu skaits pirms TLS sertifikāta termiņa beigām, kas izraisa pasliktinātu stāvokli."

#: lib/Settings.php
msgid "TLS Expiry Critical (days)"
msgstr "TLS termiņa beigšanās kritiskais slieksnis (dienas)"

#: lib/Settings.php
msgid "Days before TLS certificate expiry triggering critical status."
msgstr "Dienu skaits pirms TLS sertifikāta termiņa beigām, kas izraisa kritisku stāvokli."

#: lib/Settings.php
msgid "Keep Tables on Uninstall"
msgstr "Saglabāt tabulas atinstalējot"

#: lib/Settings.php
msgid "Preserve plugin_wordpress database tables when uninstalling the plugin."
msgstr "Saglabāt plugin_wordpress datubāzes tabulas, atinstalējot spraudni."

