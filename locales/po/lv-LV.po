msgstr "Jaunākais izmēģinājuma zondes rezultāts"

#: lib/Ui/PagesRenderer.php
msgid "Update Drift, Cron Stalls & Autoload Bloat"
msgstr "Atjauninājumu novirzes, Cron apstāšanās un automātiskās ielādes pārblīvēšana"

#: lib/Ui/PagesRenderer.php
msgid "Vault Status:"
msgstr "Glabātuves statuss:"

