#: lib/Settings.php
msgid "WordPress Fleet Security & Vault"
msgstr "WordPress vlootbeveiliging en kluis"

#: lib/Settings.php
msgid "Vault Keyfile Path"
msgstr "Pad naar kluissleutelbestand"

#: lib/Settings.php
msgid "Absolute path to the external 256-bit AES-GCM keyfile used to encrypt Application Passwords at rest. Never replicated to remote pollers."
msgstr "Absoluut pad naar het externe 256-bit AES-GCM-sleutelbestand dat wordt gebruikt om applicatiewachtwoorden in rust te versleutelen. Wordt nooit gerepliceerd naar externe pollers."

#: lib/Settings.php
msgid "Internal Host Allowlist"
msgstr "Toegestane interne hosts"

#: lib/Settings.php
msgid "Comma-separated hostnames or wildcard patterns (e.g. *.corp.example) exempt from private-IP SSRF blocking."
msgstr "Door komma's gescheiden hostnamen of wildcardpatronen (bijv. *.corp.example) die zijn vrijgesteld van SSRF-blokkering voor privé-IP's."

#: lib/Settings.php
msgid "Internal CIDR Allowlist"
msgstr "Toegestane interne CIDR-bereiken"

#: lib/Settings.php
msgid "Comma-separated internal CIDR ranges explicitly permitted by OutboundGuard."
msgstr "Door komma's gescheiden interne CIDR-bereiken die expliciet door OutboundGuard worden toegestaan."

#: lib/Settings.php
msgid "Outbound Client & Adaptive Poller Sizing"
msgstr "Uitgaande client en adaptieve poller-dimensionering"

#: lib/Settings.php
msgid "Poll Interval (seconds)"
msgstr "Poll-interval (seconden)"

#: lib/Settings.php
msgid "Target fleet polling interval in seconds for Little's Law concurrency sizing."
msgstr "Streef-poll-interval van de vloot in seconden voor gelijktijdigheidsberekening volgens Little's Law."

#: lib/Settings.php
msgid "Connect Timeout (seconds)"
msgstr "Verbindingstime-out (seconden)"

#: lib/Settings.php
msgid "Maximum TCP/TLS connect duration per WordPress probe (1-15s)."
msgstr "Maximale TCP/TLS-verbindingsduur per WordPress-probe (1-15s)."

#: lib/Settings.php
msgid "Read Timeout (seconds)"
msgstr "Leestime-out (seconden)"

#: lib/Settings.php
msgid "Maximum total HTTP read duration per WordPress probe (1-60s)."
msgstr "Maximale totale HTTP-leesduur per WordPress-probe (1-60s)."

#: lib/Settings.php
msgid "Max Response Size (bytes)"
msgstr "Maximale antwoordgrootte (bytes)"

#: lib/Settings.php
msgid "Hard byte ceiling per HTTP response (capped at 2097152 bytes / 2 MiB)."
msgstr "Harde bytelimiet per HTTP-antwoord (begrensd op 2097152 bytes / 2 MiB)."

#: lib/Settings.php
msgid "CoDel Target Standing Delay (ms)"
msgstr "CoDel streefwaarde staande vertraging (ms)"

#: lib/Settings.php
msgid "Queue standing-delay target in milliseconds before adaptive concurrency backs off."
msgstr "Streefwaarde voor staande wachtrijvertraging in milliseconden voordat adaptieve gelijktijdigheid terugschakelt."

#: lib/Settings.php
msgid "Minimum Concurrency"
msgstr "Minimale gelijktijdigheid"

#: lib/Settings.php
msgid "Lower bound on concurrent WordPress probe workers per collector shard."
msgstr "Ondergrens voor gelijktijdige WordPress-probeworkers per collector-shard."

#: lib/Settings.php
msgid "Maximum Concurrency"
msgstr "Maximale gelijktijdigheid"

#: lib/Settings.php
msgid "Upper bound on concurrent WordPress probe workers per collector shard."
msgstr "Bovengrens voor gelijktijdige WordPress-probeworkers per collector-shard."

#: lib/Settings.php
msgid "HTTP User-Agent"
msgstr "HTTP User-Agent"

#: lib/Settings.php
msgid "User-Agent header sent on read-only REST and Site Health probes."
msgstr "User-Agent-header die wordt verzonden bij alleen-lezen REST- en sitestatusprobes."

#: lib/Settings.php
msgid "Fleet Health & Thold Thresholds"
msgstr "Vlootstatus en Thold-drempelwaarden"

#: lib/Settings.php
msgid "Default Apdex T (ms)"
msgstr "Standaard Apdex T (ms)"

#: lib/Settings.php
msgid "Satisfied TTFB threshold T in milliseconds (tolerating threshold is 4T)."
msgstr "Tevreden TTFB-drempelwaarde T in milliseconden (toleratiedrempel is 4T)."

#: lib/Settings.php
msgid "Autoload Bloat Warning (bytes)"
msgstr "Waarschuwing autoload-omvang (bytes)"

#: lib/Settings.php
msgid "wp_options autoloaded size warning threshold (default 819200 / 800 KiB)."
msgstr "Waarschuwingsdrempel voor autoload-grootte van wp_options (standaard 819200 / 800 KiB)."

#: lib/Settings.php
msgid "Autoload Bloat Critical (bytes)"
msgstr "Kritieke drempel autoload-omvang (bytes)"

#: lib/Settings.php
msgid "wp_options autoloaded size critical threshold (default 2097152 / 2 MiB)."
msgstr "Kritieke drempel voor autoload-grootte van wp_options (standaard 2097152 / 2 MiB)."

#: lib/Settings.php
msgid "WP-Cron Lag Warning (seconds)"
msgstr "Waarschuwing WP-Cron-achterstand (seconden)"

#: lib/Settings.php
msgid "Oldest overdue WP-Cron job lag threshold for degraded status."
msgstr "Achterstandsdrempel voor de oudste achterstallige WP-Cron-taak voor verminderde status."

#: lib/Settings.php
msgid "TLS Expiry Warning (days)"
msgstr "Waarschuwing TLS-vervaldatum (dagen)"

#: lib/Settings.php
msgid "Days before TLS certificate expiry triggering degraded status."
msgstr "Aantal dagen vóór het verlopen van het TLS-certificaat dat een verminderde status veroorzaakt."

#: lib/Settings.php
msgid "TLS Expiry Critical (days)"
msgstr "Kritieke drempel TLS-vervaldatum (dagen)"

#: lib/Settings.php
msgid "Days before TLS certificate expiry triggering critical status."
msgstr "Aantal dagen vóór het verlopen van het TLS-certificaat dat een kritieke status veroorzaakt."

#: lib/Settings.php
msgid "Keep Tables on Uninstall"
msgstr "Tabellen behouden bij verwijderen"

#: lib/Settings.php
msgid "Preserve plugin_wordpress database tables when uninstalling the plugin."
msgstr "Behoud de databasetabellen van plugin_wordpress bij het verwijderen van de plug-in."

