#: lib/Pages.php
msgid "WordPress View"
msgstr "Visualização WordPress"

#: lib/Pages.php
msgid "WordPress Operator"
msgstr "Operador WordPress"

#: lib/Pages.php
msgid "WordPress Admin"
msgstr "Administrador WordPress"

#: lib/Pages.php
msgid "WordPress Fleet Overview"
msgstr "Visão geral da frota WordPress"

#: lib/Pages.php
msgid "WordPress Drift & Probes"
msgstr "Desvios e sondas WordPress"

#: lib/Pages.php
msgid "WordPress Inventory & Vault"
msgstr "Inventário e cofre WordPress"

#: lib/Settings.php
msgid "WordPress Fleet Security & Vault"
msgstr "Segurança da frota WordPress e cofre"

#: lib/Settings.php
msgid "Vault Keyfile Path"
msgstr "Caminho do arquivo de chave do cofre"

#: lib/Settings.php
msgid "Absolute path to the external 256-bit AES-GCM keyfile used to encrypt Application Passwords at rest. Never replicated to remote pollers."
msgstr "Caminho absoluto para o arquivo de chave externo 256-bit AES-GCM usado para criptografar senhas de aplicativo em repouso. Nunca é replicado para pollers remotos."

#: lib/Settings.php
msgid "Internal Host Allowlist"
msgstr "Lista de permissão de hosts internos"

#: lib/Settings.php
msgid "Comma-separated hostnames or wildcard patterns (e.g. *.corp.example) exempt from private-IP SSRF blocking."
msgstr "Nomes de host ou padrões curinga separados por vírgula (ex.: *.corp.example) isentos do bloqueio SSRF de IP privado."

#: lib/Settings.php
msgid "Internal CIDR Allowlist"
msgstr "Lista de permissão de CIDR interno"

#: lib/Settings.php
msgid "Comma-separated internal CIDR ranges explicitly permitted by OutboundGuard."
msgstr "Faixas CIDR internas separadas por vírgula explicitamente permitidas pelo OutboundGuard."

#: lib/Settings.php
msgid "Outbound Client & Adaptive Poller Sizing"
msgstr "Cliente de saída e dimensionamento adaptativo do poller"

#: lib/Settings.php
msgid "Poll Interval (seconds)"
msgstr "Intervalo de coleta (segundos)"

#: lib/Settings.php
msgid "Target fleet polling interval in seconds for Little's Law concurrency sizing."
msgstr "Intervalo de coleta desejado da frota em segundos para o dimensionamento de concorrência segundo Little's Law."

#: lib/Settings.php
msgid "Connect Timeout (seconds)"
msgstr "Tempo limite de conexão (segundos)"

#: lib/Settings.php
msgid "Maximum TCP/TLS connect duration per WordPress probe (1-15s)."
msgstr "Duração máxima de conexão TCP/TLS por sonda WordPress (1-15s)."

#: lib/Settings.php
msgid "Read Timeout (seconds)"
msgstr "Tempo limite de leitura (segundos)"

#: lib/Settings.php
msgid "Maximum total HTTP read duration per WordPress probe (1-60s)."
msgstr "Duração total máxima de leitura HTTP por sonda WordPress (1-60s)."

#: lib/Settings.php
msgid "Max Response Size (bytes)"
msgstr "Tamanho máximo da resposta (bytes)"

#: lib/Settings.php
msgid "Hard byte ceiling per HTTP response (capped at 2097152 bytes / 2 MiB)."
msgstr "Limite rígido de bytes por resposta HTTP (limitado a 2097152 bytes / 2 MiB)."

#: lib/Settings.php
msgid "CoDel Target Standing Delay (ms)"
msgstr "Atraso permanente alvo do CoDel (ms)"

#: lib/Settings.php
msgid "Queue standing-delay target in milliseconds before adaptive concurrency backs off."
msgstr "Atraso permanente alvo da fila em milissegundos antes que a concorrência adaptativa recue."

#: lib/Settings.php
msgid "Minimum Concurrency"
msgstr "Concorrência mínima"

#: lib/Settings.php
msgid "Lower bound on concurrent WordPress probe workers per collector shard."
msgstr "Limite inferior de workers concorrentes de sonda WordPress por partição do coletor."

#: lib/Settings.php
msgid "Maximum Concurrency"
msgstr "Concorrência máxima"

#: lib/Settings.php
msgid "Upper bound on concurrent WordPress probe workers per collector shard."
msgstr "Limite superior de workers concorrentes de sonda WordPress por partição do coletor."

#: lib/Settings.php
msgid "HTTP User-Agent"
msgstr "HTTP User-Agent"

#: lib/Settings.php
msgid "User-Agent header sent on read-only REST and Site Health probes."
msgstr "Cabeçalho User-Agent enviado em sondas REST e de integridade do site somente leitura."

#: lib/Settings.php
msgid "Fleet Health & Thold Thresholds"
msgstr "Saúde da frota e limiares do Thold"

#: lib/Settings.php
msgid "Default Apdex T (ms)"
msgstr "Apdex T padrão (ms)"

#: lib/Settings.php
msgid "Satisfied TTFB threshold T in milliseconds (tolerating threshold is 4T)."
msgstr "Limiar TTFB satisfatório T em milissegundos (o limiar tolerável é 4T)."

#: lib/Settings.php
msgid "Autoload Bloat Warning (bytes)"
msgstr "Aviso de inchaço do autoload (bytes)"

#: lib/Settings.php
msgid "wp_options autoloaded size warning threshold (default 819200 / 800 KiB)."
msgstr "Limiar de aviso para o tamanho de autoload de wp_options (padrão 819200 / 800 KiB)."

#: lib/Settings.php
msgid "Autoload Bloat Critical (bytes)"
msgstr "Crítico de inchaço do autoload (bytes)"

#: lib/Settings.php
msgid "wp_options autoloaded size critical threshold (default 2097152 / 2 MiB)."
msgstr "Limiar crítico para o tamanho de autoload de wp_options (padrão 2097152 / 2 MiB)."

#: lib/Settings.php
msgid "WP-Cron Lag Warning (seconds)"
msgstr "Aviso de atraso do WP-Cron (segundos)"

#: lib/Settings.php
msgid "Oldest overdue WP-Cron job lag threshold for degraded status."
msgstr "Limiar de atraso da tarefa WP-Cron mais atrasada para o status degradado."

#: lib/Settings.php
msgid "TLS Expiry Warning (days)"
msgstr "Aviso de expiração TLS (dias)"

#: lib/Settings.php
msgid "Days before TLS certificate expiry triggering degraded status."
msgstr "Dias antes da expiração do certificado TLS para acionar o status degradado."

#: lib/Settings.php
msgid "TLS Expiry Critical (days)"
msgstr "Crítico de expiração TLS (dias)"

#: lib/Settings.php
msgid "Days before TLS certificate expiry triggering critical status."
msgstr "Dias antes da expiração do certificado TLS para acionar o status crítico."

#: lib/Settings.php
msgid "Keep Tables on Uninstall"
msgstr "Manter tabelas ao desinstalar"

#: lib/Settings.php
msgid "Preserve plugin_wordpress database tables when uninstalling the plugin."
msgstr "Preservar as tabelas do banco de dados plugin_wordpress ao desinstalar o plugin."

#: lib/Ui/PagesRenderer.php
msgid "Fleet Health Summary"
msgstr "Resumo de saúde da frota"

#: lib/Ui/PagesRenderer.php
msgid "MAD Latency Anomalies"
msgstr "Anomalias de latência MAD"

#: lib/Ui/PagesRenderer.php
msgid "Site Snapshots"
msgstr "Instantâneos dos sites"

#: lib/Ui/PagesRenderer.php
msgid "Cacti Thold Baseline Templates"
msgstr "Modelos de linha de base do Cacti Thold"

#: lib/Ui/PagesRenderer.php
msgid "Dry-Run Probe Site:"
msgstr "Site para sonda simulada:"

#: lib/Ui/PagesRenderer.php
msgid "Run Read-Only Probe"
msgstr "Executar sonda somente leitura"

#: lib/Ui/PagesRenderer.php
msgid "Latest Dry-Run Probe Result"
msgstr "Último resultado da sonda simulada"

#: lib/Ui/PagesRenderer.php
msgid "Update Drift, Cron Stalls & Autoload Bloat"
msgstr "Desvios de atualização, travamentos do Cron e inchaço do autoload"

#: lib/Ui/PagesRenderer.php
msgid "Vault Status:"
msgstr "Status do cofre:"

#: lib/Ui/PagesRenderer.php
msgid "Add or Update WordPress Site"
msgstr "Adicionar ou atualizar site WordPress"

#: lib/Ui/PagesRenderer.php
msgid "Save Site"
msgstr "Salvar site"

#: lib/Ui/PagesRenderer.php
msgid "Configured Fleet Inventory"
msgstr "Inventário da frota configurada"

#: lib/Ui/PagesRenderer.php
msgid "Delete"
msgstr "Excluir"

