msgstr "Reba WordPress"

#: lib/Pages.php
msgid "WordPress Operator"
msgstr "Umukoresha wa WordPress"

#: lib/Pages.php
msgid "WordPress Admin"
msgstr "Umuyobozi wa WordPress"

#: lib/Pages.php
msgid "WordPress Fleet Overview"
msgstr "Incamake y'imbuga za WordPress"

#: lib/Pages.php
msgid "WordPress Drift & Probes"
msgstr "Impinduka n'isuzuma rya WordPress"

#: lib/Pages.php
msgid "WordPress Inventory & Vault"
msgstr "Urutonde n'ububiko bw'ibanga bwa WordPress"

#: lib/Settings.php
msgid "WordPress Fleet Security & Vault"
msgstr "Umutekano n'ububiko bw'ibanga bw'imbuga za WordPress"

#: lib/Settings.php
msgid "Vault Keyfile Path"
msgstr "Inzira y'idosiye y'urufunguzo rw'ububiko bw'ibanga"

#: lib/Settings.php
msgid "Absolute path to the external 256-bit AES-GCM keyfile used to encrypt Application Passwords at rest. Never replicated to remote pollers."
msgstr "Inzira yuzuye igana ku idosiye y'urufunguzo rwo hanze rwa 256-bit AES-GCM ikoreshwa mu gusobeka amagambo y'ibanga ya porogaramu abitswe. Ntiyigera yigana ku bakusanya amakuru bo kure."

#: lib/Settings.php
msgid "Internal Host Allowlist"
msgstr "Urutonde rw'ibikoresho by'imbere byemewe"

#: lib/Settings.php
msgid "Comma-separated hostnames or wildcard patterns (e.g. *.corp.example) exempt from private-IP SSRF blocking."
msgstr "Amazina y'ibikoresho cyangwa imiterere y'utumenyetso (urugero *.corp.example) atandukanyijwe n'akitso adafungirwa n'uburinzi bwa SSRF kuri IP z'ibanga."

#: lib/Settings.php
msgid "Internal CIDR Allowlist"
msgstr "Urutonde rwa CIDR z'imbere zemewe"

#: lib/Settings.php
msgid "Comma-separated internal CIDR ranges explicitly permitted by OutboundGuard."
msgstr "Ibipimo bya CIDR by'imbere bitandukanyijwe n'akitso byemewe ku mugaragaro na OutboundGuard."

#: lib/Settings.php
msgid "Outbound Client & Adaptive Poller Sizing"
msgstr "Umukiriya wo hanze n'igenwa ry'ingano y'ikusanya ryihinduranya"

#: lib/Settings.php
msgid "Poll Interval (seconds)"
msgstr "Intera y'ikusanya (amasegonda)"

#: lib/Settings.php
msgid "Target fleet polling interval in seconds for Little's Law concurrency sizing."
msgstr "Intera igamijwe yo gukusanya amakuru y'imbuga mu masegonda yo kugena umubare w'ibikorwa bibera rimwe hifashishijwe Little's Law."

#: lib/Settings.php
msgid "Connect Timeout (seconds)"
msgstr "Igihe ntarengwa cyo kwihuza (amasegonda)"

#: lib/Settings.php
msgid "Maximum TCP/TLS connect duration per WordPress probe (1-15s)."
msgstr "Igihe ntarengwa cyo kwihuza kwa TCP/TLS kuri buri suzuma rya WordPress (1-15s)."

#: lib/Settings.php
msgid "Read Timeout (seconds)"
msgstr "Igihe ntarengwa cyo gusoma (amasegonda)"

#: lib/Settings.php
msgid "Maximum total HTTP read duration per WordPress probe (1-60s)."
msgstr "Igihe ntarengwa cyose cyo gusoma HTTP kuri buri suzuma rya WordPress (1-60s)."

#: lib/Settings.php
msgid "Max Response Size (bytes)"
msgstr "Ingano ntarengwa y'igisubizo (bytes)"

#: lib/Settings.php
msgid "Hard byte ceiling per HTTP response (capped at 2097152 bytes / 2 MiB)."
msgstr "Umupaka ntarengwa wa bytes kuri buri gisubizo cya HTTP (ntarengwa ni 2097152 bytes / 2 MiB)."

#: lib/Settings.php
msgid "CoDel Target Standing Delay (ms)"
msgstr "Itinda rihoraho rigamijwe rya CoDel (ms)"

#: lib/Settings.php
msgid "Queue standing-delay target in milliseconds before adaptive concurrency backs off."
msgstr "Itinda rihoraho mu murongo rigamijwe mu milisegonda mbere y'uko ubushobozi bwo gukorera rimwe bugabanywa."

#: lib/Settings.php
msgid "Minimum Concurrency"
msgstr "Umubare muto w'ibikorwa bibera rimwe"

#: lib/Settings.php
msgid "Lower bound on concurrent WordPress probe workers per collector shard."
msgstr "Umupaka wo hasi w'abakozi b'isuzuma rya WordPress bakorera rimwe kuri buri gice cy'ukusanya."

#: lib/Settings.php
msgid "Maximum Concurrency"
msgstr "Umubare munini w'ibikorwa bibera rimwe"

#: lib/Settings.php
msgid "Upper bound on concurrent WordPress probe workers per collector shard."
msgstr "Umupaka wo hejuru w'abakozi b'isuzuma rya WordPress bakorera rimwe kuri buri gice cy'ukusanya."

#: lib/Settings.php
msgid "HTTP User-Agent"
msgstr "Umutwe wa HTTP User-Agent"

#: lib/Settings.php
msgid "User-Agent header sent on read-only REST and Site Health probes."
msgstr "Umutwe wa User-Agent woherezwa mu isuzuma ryo gusoma gusa rya REST n'ubuzima bw'urubuga."

#: lib/Settings.php
msgid "Fleet Health & Thold Thresholds"
msgstr "Ubuzima bw'imbuga n'imipaka ya Thold"

#: lib/Settings.php
msgid "Default Apdex T (ms)"
msgstr "Apdex T isanzwe (ms)"

#: lib/Settings.php
msgid "Satisfied TTFB threshold T in milliseconds (tolerating threshold is 4T)."
msgstr "Umupaka wa TTFB ushimishije T mu milisegonda (umupaka wihanganirwa ni 4T)."

#: lib/Settings.php
msgid "Autoload Bloat Warning (bytes)"
msgstr "Umuburo w'uburemere bwa autoload (bytes)"

#: lib/Settings.php
msgid "wp_options autoloaded size warning threshold (default 819200 / 800 KiB)."
msgstr "Umupaka w'umuburo w'ingano y'ibipakururwa byikora muri wp_options (isanzwe ni 819200 / 800 KiB)."

#: lib/Settings.php
msgid "Autoload Bloat Critical (bytes)"
msgstr "Ikibazo gikomeye cy'uburemere bwa autoload (bytes)"

#: lib/Settings.php
msgid "wp_options autoloaded size critical threshold (default 2097152 / 2 MiB)."
msgstr "Umupaka ukomeye w'ingano y'ibipakururwa byikora muri wp_options (isanzwe ni 2097152 / 2 MiB)."

#: lib/Settings.php
msgid "WP-Cron Lag Warning (seconds)"
msgstr "Umuburo w'itinda rya WP-Cron (amasegonda)"

#: lib/Settings.php
msgid "Oldest overdue WP-Cron job lag threshold for degraded status."
msgstr "Umupaka w'itinda ry'umurimo wa WP-Cron watinze cyane kurusha iyindi kugira ngo bigaragaze ko imikorere yagabanutse."

#: lib/Settings.php
msgid "TLS Expiry Warning (days)"
msgstr "Umuburo wo kurangira kwa TLS (iminsi)"

#: lib/Settings.php
msgid "Days before TLS certificate expiry triggering degraded status."
msgstr "Iminsi isigaye mbere y'uko icyemezo cya TLS kirangira itera uko imikorere igabanutse."

#: lib/Settings.php
msgid "TLS Expiry Critical (days)"
msgstr "Ikibazo gikomeye cyo kurangira kwa TLS (iminsi)"

#: lib/Settings.php
msgid "Days before TLS certificate expiry triggering critical status."
msgstr "Iminsi isigaye mbere y'uko icyemezo cya TLS kirangira itera uko ibintu bimeze nabi cyane."

#: lib/Settings.php
msgid "Keep Tables on Uninstall"
msgstr "Guma ubika imbonerahamwe mu gihe cyo gukuramo"

#: lib/Settings.php
msgid "Preserve plugin_wordpress database tables when uninstalling the plugin."
msgstr "Kubungabunga imbonerahamwe z'ububiko bw'amakuru za plugin_wordpress mu gihe ukuramo umugereka."

#: lib/Ui/PagesRenderer.php
msgid "Fleet Health Summary"
msgstr "Incamake y'ubuzima bw'imbuga"

