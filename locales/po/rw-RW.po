#: lib/Ui/PagesRenderer.php
msgid "Latest Dry-Run Probe Result"
msgstr "Ibisubizo biheruka by'isuzuma ry'igerageza"

#: lib/Ui/PagesRenderer.php
msgid "Update Drift, Cron Stalls & Autoload Bloat"
msgstr "Impinduka z'ivugurura, guhagarara kwa cron n'uburemere bwa autoload"

#: lib/Ui/PagesRenderer.php
msgid "Vault Status:"
msgstr "Uko ububiko bw'ibanga buhagaze:"

#: lib/Ui/PagesRenderer.php
