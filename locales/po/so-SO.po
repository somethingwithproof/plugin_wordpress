msgstr "Qaababka Aasaasiga ah ee Cacti Thold"

#: lib/Ui/PagesRenderer.php
msgid "Dry-Run Probe Site:"
msgstr "Bogga Baaritaanka Tijaabada:"

#: lib/Ui/PagesRenderer.php
