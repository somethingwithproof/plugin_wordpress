msgstr "Orod Baaritaanka Akhriska Keliya"

#: lib/Ui/PagesRenderer.php
msgid "Latest Dry-Run Probe Result"
msgstr "Natiijadii Ugu Dambeysay ee Baaritaanka Tijaabada"

#: lib/Ui/PagesRenderer.php
msgid "Update Drift, Cron Stalls & Autoload Bloat"
msgstr "Isbeddelka Cusbooneysiinta, Hakadka Cron & Bararka Autoload"

#: lib/Ui/PagesRenderer.php
msgid "Vault Status:"
msgstr "Xaaladda Kaydka Sirta:"

#: lib/Ui/PagesRenderer.php
msgid "Add or Update WordPress Site"
msgstr "Ku Dar ama Cusbooneysii Bogga WordPress"

#: lib/Ui/PagesRenderer.php
msgid "Save Site"
msgstr "Kaydi Bogga"

#: lib/Ui/PagesRenderer.php
msgid "Configured Fleet Inventory"
msgstr "Liiska Kooxda La Habeeyay"

#: lib/Ui/PagesRenderer.php
msgid "Delete"
msgstr "Tirtir"

