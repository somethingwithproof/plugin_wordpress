msgstr "Оператер WordPress-а"

#: lib/Pages.php
msgid "WordPress Admin"
msgstr "Администратор WordPress-а"

#: lib/Pages.php
msgid "WordPress Fleet Overview"
msgstr "Преглед флоте WordPress сајтова"

#: lib/Pages.php
msgid "WordPress Drift & Probes"
msgstr "Одступања и пробе WordPress-а"

#: lib/Pages.php
msgid "WordPress Inventory & Vault"
msgstr "Инвентар и трезор WordPress-а"

#: lib/Settings.php
msgid "WordPress Fleet Security & Vault"
msgstr "Безбедност и трезор флоте WordPress сајтова"

#: lib/Settings.php
msgid "Vault Keyfile Path"
msgstr "Путања до датотеке кључа трезора"

#: lib/Settings.php
msgid "Absolute path to the external 256-bit AES-GCM keyfile used to encrypt Application Passwords at rest. Never replicated to remote pollers."
msgstr "Апсолутна путања до спољне датотеке кључа 256-bit AES-GCM која се користи за шифровање лозинки апликација у мировању. Никада се не реплицира на удаљене полере."

#: lib/Settings.php
msgid "Internal Host Allowlist"
msgstr "Листа дозвољених интерних хостова"

#: lib/Settings.php
msgid "Comma-separated hostnames or wildcard patterns (e.g. *.corp.example) exempt from private-IP SSRF blocking."
msgstr "Имена хостова или џокер обрасци (нпр. *.corp.example) одвојени зарезима који су изузети од SSRF блокирања приватних IP адреса."

#: lib/Settings.php
msgid "Internal CIDR Allowlist"
msgstr "Листа дозвољених интерних CIDR опсега"

#: lib/Settings.php
msgid "Comma-separated internal CIDR ranges explicitly permitted by OutboundGuard."
msgstr "Интерни CIDR опсези одвојени зарезима које OutboundGuard изричито дозвољава."

#: lib/Settings.php
msgid "Outbound Client & Adaptive Poller Sizing"
msgstr "Одлазни клијент и адаптивно димензионисање полера"

#: lib/Settings.php
msgid "Poll Interval (seconds)"
msgstr "Интервал очитавања (секунде)"

#: lib/Settings.php
msgid "Target fleet polling interval in seconds for Little's Law concurrency sizing."
msgstr "Циљни интервал очитавања флоте у секундама за димензионисање паралелности према Little's Law."

#: lib/Settings.php
msgid "Connect Timeout (seconds)"
msgstr "Временско ограничење повезивања (секунде)"

#: lib/Settings.php
msgid "Maximum TCP/TLS connect duration per WordPress probe (1-15s)."
msgstr "Максимално трајање TCP/TLS повезивања по WordPress проби (1-15s)."

#: lib/Settings.php
msgid "Read Timeout (seconds)"
msgstr "Временско ограничење читања (секунде)"

#: lib/Settings.php
msgid "Maximum total HTTP read duration per WordPress probe (1-60s)."
msgstr "Максимално укупно трајање HTTP читања по WordPress проби (1-60s)."

#: lib/Settings.php
msgid "Max Response Size (bytes)"
msgstr "Максимална величина одговора (бајтови)"

#: lib/Settings.php
msgid "Hard byte ceiling per HTTP response (capped at 2097152 bytes / 2 MiB)."
msgstr "Строго ограничење у бајтовима по HTTP одговору (ограничено на 2097152 бајтова / 2 MiB)."

#: lib/Settings.php
msgid "CoDel Target Standing Delay (ms)"
msgstr "Циљно стално кашњење CoDel (ms)"

#: lib/Settings.php
msgid "Queue standing-delay target in milliseconds before adaptive concurrency backs off."
msgstr "Циљно стално кашњење реда у милисекундама пре него што адаптивна паралелност смањи оптерећење."

#: lib/Settings.php
msgid "Minimum Concurrency"
msgstr "Минимална паралелност"

#: lib/Settings.php
msgid "Lower bound on concurrent WordPress probe workers per collector shard."
msgstr "Доња граница броја истовремених радника за WordPress пробе по шарду сакупљача."

#: lib/Settings.php
msgid "Maximum Concurrency"
msgstr "Максимална паралелност"

#: lib/Settings.php
msgid "Upper bound on concurrent WordPress probe workers per collector shard."
msgstr "Горња граница броја истовремених радника за WordPress пробе по шарду сакупљача."

#: lib/Settings.php
msgid "HTTP User-Agent"
msgstr "Заглавље HTTP User-Agent"

#: lib/Settings.php
msgid "User-Agent header sent on read-only REST and Site Health probes."
msgstr "Заглавље User-Agent које се шаље у пробама REST и здравља сајта само за читање."

#: lib/Settings.php
msgid "Fleet Health & Thold Thresholds"
msgstr "Здравље флоте и Thold прагови"

#: lib/Settings.php
msgid "Default Apdex T (ms)"
msgstr "Подразумевани Apdex T (ms)"

#: lib/Settings.php
msgid "Satisfied TTFB threshold T in milliseconds (tolerating threshold is 4T)."
msgstr "Праг задовољавајућег TTFB T у милисекундама (толерантни праг је 4T)."

#: lib/Settings.php
msgid "Autoload Bloat Warning (bytes)"
msgstr "Упозорење за преоптерећење аутоматског учитавања (бајтови)"

#: lib/Settings.php
msgid "wp_options autoloaded size warning threshold (default 819200 / 800 KiB)."
msgstr "Праг упозорења за величину аутоматски учитаних података у wp_options (подразумевано 819200 / 800 KiB)."

#: lib/Settings.php
msgid "Autoload Bloat Critical (bytes)"
msgstr "Критични ниво преоптерећења аутоматског учитавања (бајтови)"

#: lib/Settings.php
msgid "wp_options autoloaded size critical threshold (default 2097152 / 2 MiB)."
msgstr "Критични праг за величину аутоматски учитаних података у wp_options (подразумевано 2097152 / 2 MiB)."

#: lib/Settings.php
msgid "WP-Cron Lag Warning (seconds)"
msgstr "Упозорење за кашњење WP-Cron-а (секунде)"

#: lib/Settings.php
msgid "Oldest overdue WP-Cron job lag threshold for degraded status."
msgstr "Праг кашњења најстаријег закаснелог WP-Cron задатка за деградирани статус."

#: lib/Settings.php
msgid "TLS Expiry Warning (days)"
msgstr "Упозорење за истек TLS-а (дани)"

#: lib/Settings.php
msgid "Days before TLS certificate expiry triggering degraded status."
msgstr "Број дана пре истека TLS сертификата који активира деградирани статус."

#: lib/Settings.php
msgid "TLS Expiry Critical (days)"
msgstr "Критични рок истека TLS-а (дани)"

#: lib/Settings.php
msgid "Days before TLS certificate expiry triggering critical status."
msgstr "Број дана пре истека TLS сертификата који активира критични статус."

#: lib/Settings.php
msgid "Keep Tables on Uninstall"
msgstr "Задржи табеле при деинсталацији"

#: lib/Settings.php
msgid "Preserve plugin_wordpress database tables when uninstalling the plugin."
msgstr "Сачувај табеле базе података plugin_wordpress приликом деинсталације додатка."

