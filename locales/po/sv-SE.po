msgstr "Kör skrivskyddad sond"

#: lib/Ui/PagesRenderer.php
msgid "Latest Dry-Run Probe Result"
msgstr "Senaste resultat från torrkörningssond"

#: lib/Ui/PagesRenderer.php
msgid "Update Drift, Cron Stalls & Autoload Bloat"
msgstr "Uppdateringsavvikelser, cron-stopp och uppsvälld autoinläsning"

#: lib/Ui/PagesRenderer.php
msgid "Vault Status:"
msgstr "Valvstatus:"

#: lib/Ui/PagesRenderer.php
msgid "Add or Update WordPress Site"
msgstr "Lägg till eller uppdatera WordPress-webbplats"

#: lib/Ui/PagesRenderer.php
msgid "Save Site"
msgstr "Spara webbplats"

#: lib/Ui/PagesRenderer.php
msgid "Configured Fleet Inventory"
msgstr "Konfigurerad flottinventering"

