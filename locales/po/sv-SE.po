msgstr "WordPress-inventering och valv"

#: lib/Settings.php
msgid "WordPress Fleet Security & Vault"
msgstr "Säkerhet och valv för WordPress-flotta"

#: lib/Settings.php
msgid "Vault Keyfile Path"
msgstr "Sökväg till valvnyckelfil"

#: lib/Settings.php
msgid "Absolute path to the external 256-bit AES-GCM keyfile used to encrypt Application Passwords at rest. Never replicated to remote pollers."
msgstr "Absolut sökväg till den externa 256-bit AES-GCM-nyckelfilen som används för att kryptera applikationslösenord i vila. Replikeras aldrig till fjärrpollare."

#: lib/Settings.php
msgid "Internal Host Allowlist"
msgstr "Tillåtenlista för interna värdar"

#: lib/Settings.php
msgid "Comma-separated hostnames or wildcard patterns (e.g. *.corp.example) exempt from private-IP SSRF blocking."
msgstr "Kommaseparerade värdnamn eller jokerteckenmönster (t.ex. *.corp.example) som är undantagna från SSRF-blockering av privata IP-adresser."

#: lib/Settings.php
msgid "Internal CIDR Allowlist"
msgstr "Tillåtenlista för interna CIDR-intervall"

#: lib/Settings.php
msgid "Comma-separated internal CIDR ranges explicitly permitted by OutboundGuard."
msgstr "Kommaseparerade interna CIDR-intervall som uttryckligen tillåts av OutboundGuard."

#: lib/Settings.php
msgid "Outbound Client & Adaptive Poller Sizing"
msgstr "Utgående klient och adaptiv storleksanpassning av pollare"

#: lib/Settings.php
msgid "Poll Interval (seconds)"
msgstr "Avfrågningsintervall (sekunder)"

#: lib/Settings.php
msgid "Target fleet polling interval in seconds for Little's Law concurrency sizing."
msgstr "Målintervall för flottavfrågning i sekunder för samtidighetsdimensionering enligt Little's Law."

#: lib/Settings.php
msgid "Connect Timeout (seconds)"
msgstr "Tidsgräns för anslutning (sekunder)"

#: lib/Settings.php
msgid "Maximum TCP/TLS connect duration per WordPress probe (1-15s)."
msgstr "Maximal TCP/TLS-anslutningstid per WordPress-sond (1-15s)."

#: lib/Settings.php
msgid "Read Timeout (seconds)"
msgstr "Tidsgräns för läsning (sekunder)"

#: lib/Settings.php
msgid "Maximum total HTTP read duration per WordPress probe (1-60s)."
msgstr "Maximal total HTTP-lästid per WordPress-sond (1-60s)."

#: lib/Settings.php
msgid "Max Response Size (bytes)"
msgstr "Maximal svarsstorlek (byte)"

#: lib/Settings.php
msgid "Hard byte ceiling per HTTP response (capped at 2097152 bytes / 2 MiB)."
msgstr "Hård gräns i byte per HTTP-svar (begränsad till 2097152 byte / 2 MiB)."

#: lib/Settings.php
msgid "CoDel Target Standing Delay (ms)"
msgstr "CoDel-mål för stående fördröjning (ms)"

#: lib/Settings.php
msgid "Queue standing-delay target in milliseconds before adaptive concurrency backs off."
msgstr "Mål för stående köfördröjning i millisekunder innan adaptiv samtidighet drar ned."

#: lib/Settings.php
msgid "Minimum Concurrency"
msgstr "Minsta samtidighet"

#: lib/Settings.php
msgid "Lower bound on concurrent WordPress probe workers per collector shard."
msgstr "Undre gräns för samtidiga WordPress-sondarbetare per insamlarshard."

#: lib/Settings.php
msgid "Maximum Concurrency"
msgstr "Största samtidighet"

#: lib/Settings.php
msgid "Upper bound on concurrent WordPress probe workers per collector shard."
msgstr "Övre gräns för samtidiga WordPress-sondarbetare per insamlarshard."

#: lib/Settings.php
msgid "HTTP User-Agent"
msgstr "HTTP User-Agent-huvud"

#: lib/Settings.php
msgid "User-Agent header sent on read-only REST and Site Health probes."
msgstr "User-Agent-huvud som skickas vid skrivskyddade REST- och webbplatshälsosonder."

#: lib/Settings.php
msgid "Fleet Health & Thold Thresholds"
msgstr "Flotthälsa och Thold-tröskelvärden"

#: lib/Settings.php
msgid "Default Apdex T (ms)"
msgstr "Standard Apdex T (ms)"

#: lib/Settings.php
msgid "Satisfied TTFB threshold T in milliseconds (tolerating threshold is 4T)."
msgstr "Tillfredsställande TTFB-tröskelvärde T i millisekunder (toleranströskeln är 4T)."

#: lib/Settings.php
msgid "Autoload Bloat Warning (bytes)"
msgstr "Varning för uppsvälld autoinläsning (byte)"

#: lib/Settings.php
msgid "wp_options autoloaded size warning threshold (default 819200 / 800 KiB)."
msgstr "Varningströskel för autoinläst storlek i wp_options (standard 819200 / 800 KiB)."

#: lib/Settings.php
msgid "Autoload Bloat Critical (bytes)"
msgstr "Kritisk nivå för uppsvälld autoinläsning (byte)"

#: lib/Settings.php
msgid "wp_options autoloaded size critical threshold (default 2097152 / 2 MiB)."
msgstr "Kritisk tröskel för autoinläst storlek i wp_options (standard 2097152 / 2 MiB)."

#: lib/Settings.php
msgid "WP-Cron Lag Warning (seconds)"
msgstr "Varning för WP-Cron-eftersläpning (sekunder)"

#: lib/Settings.php
msgid "Oldest overdue WP-Cron job lag threshold for degraded status."
msgstr "Tröskelvärde för eftersläpning hos äldsta försenade WP-Cron-jobb för försämrad status."

#: lib/Settings.php
msgid "TLS Expiry Warning (days)"
msgstr "Varning för utgående TLS (dagar)"

#: lib/Settings.php
msgid "Days before TLS certificate expiry triggering degraded status."
msgstr "Antal dagar före TLS-certifikatets utgång som utlöser försämrad status."

#: lib/Settings.php
msgid "TLS Expiry Critical (days)"
msgstr "Kritisk gräns för utgående TLS (dagar)"

#: lib/Settings.php
msgid "Days before TLS certificate expiry triggering critical status."
msgstr "Antal dagar före TLS-certifikatets utgång som utlöser kritisk status."

#: lib/Settings.php
msgid "Keep Tables on Uninstall"
msgstr "Behåll tabeller vid avinstallation"

#: lib/Settings.php
msgid "Preserve plugin_wordpress database tables when uninstalling the plugin."
msgstr "Bevara databastabellerna för plugin_wordpress vid avinstallation av tillägget."

