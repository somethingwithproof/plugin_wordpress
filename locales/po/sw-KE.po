msgid "Run Read-Only Probe"
msgstr "Endesha Uchunguzi wa Kusoma Tu"

#: lib/Ui/PagesRenderer.php
msgid "Latest Dry-Run Probe Result"
msgstr "Matokeo ya Hivi Karibuni ya Uchunguzi wa Majaribio"

#: lib/Ui/PagesRenderer.php
msgid "Update Drift, Cron Stalls & Autoload Bloat"
msgstr "Mabadiliko ya Masasisho, Kukwama kwa Cron na Uvimbe wa Autoload"

#: lib/Ui/PagesRenderer.php
msgid "Vault Status:"
msgstr "Hali ya Hifadhi Salama:"

#: lib/Ui/PagesRenderer.php
msgid "Add or Update WordPress Site"
msgstr "Ongeza au Sasisha Tovuti ya WordPress"

#: lib/Ui/PagesRenderer.php
msgid "Save Site"
msgstr "Hifadhi Tovuti"

#: lib/Ui/PagesRenderer.php
msgid "Configured Fleet Inventory"
msgstr "Orodha ya Kundi Iliyosanidiwa"

#: lib/Ui/PagesRenderer.php
