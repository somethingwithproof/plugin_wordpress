msgid "WordPress View"
msgstr "Imbono ye-WordPress"

#: lib/Pages.php
msgid "WordPress Operator"
msgstr "Umsebenzi we-WordPress"

#: lib/Pages.php
msgid "WordPress Admin"
msgstr "Umlawuli we-WordPress"

#: lib/Pages.php
msgid "WordPress Fleet Overview"
msgstr "Isishwankathelo seQela le-WordPress"

#: lib/Pages.php
msgid "WordPress Drift & Probes"
msgstr "Ukuphambuka noVavanyo lwe-WordPress"

#: lib/Pages.php
msgid "WordPress Inventory & Vault"
msgstr "Uluhlu neGumbi loKhuseleko le-WordPress"

#: lib/Settings.php
msgid "WordPress Fleet Security & Vault"
msgstr "Ukhuseleko neGumbi loKhuseleko leQela le-WordPress"

#: lib/Settings.php
msgid "Vault Keyfile Path"
msgstr "Umendo weFayile yeSitshixo seGumbi loKhuseleko"

#: lib/Settings.php
msgid "Absolute path to the external 256-bit AES-GCM keyfile used to encrypt Application Passwords at rest. Never replicated to remote pollers."
msgstr "Umendo opheleleyo oya kwifayile yesitshixo sangaphandle se-256-bit AES-GCM esisetyenziselwa ukukhusela amagama okugqitha esicelo xa egciniwe. Asizange siphindwe kubavoti bakude."

#: lib/Settings.php
msgid "Internal Host Allowlist"
msgstr "Uluhlu lweZinginingini zaNgaphakathi eZivunyelweyo"

#: lib/Settings.php
msgid "Comma-separated hostnames or wildcard patterns (e.g. *.corp.example) exempt from private-IP SSRF blocking."
msgstr "Amagama ezinginingini okanye iipateni ze-wildcard (umz. *.corp.example) ezahlulwe ngekoma ezingabandakanywanga ekuthintelweni kwe-SSRF ye-IP yabucala."

#: lib/Settings.php
msgid "Internal CIDR Allowlist"
msgstr "Uluhlu lwe-CIDR zaNgaphakathi eZivunyelweyo"

#: lib/Settings.php
msgid "Comma-separated internal CIDR ranges explicitly permitted by OutboundGuard."
msgstr "Uluhlu lwe-CIDR zangaphakathi ezahlulwe ngekoma ezivunyelwe ngokucacileyo yi-OutboundGuard."

#: lib/Settings.php
msgid "Outbound Client & Adaptive Poller Sizing"
msgstr "Umxhasi waNgaphandle noLinganiso loMvoti oLungiselelwayo"

#: lib/Settings.php
msgid "Poll Interval (seconds)"
msgstr "Isithuba soVoto (imizuzwana)"

#: lib/Settings.php
msgid "Target fleet polling interval in seconds for Little's Law concurrency sizing."
msgstr "Isithuba ekujoliswe kuso sovoto lweqela ngemizuzwana ukuze kulinganiswe ukusebenza ngaxeshanye kwe-Little's Law."

#: lib/Settings.php
msgid "Connect Timeout (seconds)"
msgstr "Ixesha loKuphelelwa koQhagamshelwano (imizuzwana)"

#: lib/Settings.php
msgid "Maximum TCP/TLS connect duration per WordPress probe (1-15s)."
msgstr "Ubude obuphezulu bexesha loqhagamshelwano lwe-TCP/TLS kuvavanyo ngalunye lwe-WordPress (1-15s)."

#: lib/Settings.php
msgid "Read Timeout (seconds)"
msgstr "Ixesha loKuphelelwa koKufunda (imizuzwana)"

#: lib/Settings.php
msgid "Maximum total HTTP read duration per WordPress probe (1-60s)."
msgstr "Ubude bexesha obupheleleyo obuphezulu bokufunda i-HTTP kuvavanyo ngalunye lwe-WordPress (1-60s)."

#: lib/Settings.php
msgid "Max Response Size (bytes)"
msgstr "Ubukhulu obuphezulu beMpendulo (iibhayithi)"

#: lib/Settings.php
msgid "Hard byte ceiling per HTTP response (capped at 2097152 bytes / 2 MiB)."
msgstr "Umda oqinileyo weebhayithi kwimpendulo nganye ye-HTTP (uthintelwe kwiibhayithi ezingama-2097152 / 2 MiB)."

#: lib/Settings.php
msgid "CoDel Target Standing Delay (ms)"
msgstr "Ulibaziseko oluZinzileyo ekujoliswe kulo lwe-CoDel (ms)"

#: lib/Settings.php
msgid "Queue standing-delay target in milliseconds before adaptive concurrency backs off."
msgstr "Ulibaziseko oluzinzileyo lomgca ekujoliswe kulo ngeemilisekondi ngaphambi kokuba ukusebenza ngaxeshanye okulungiselelwayo kwehlise isantya."

#: lib/Settings.php
msgid "Minimum Concurrency"
msgstr "Ubuncinci boKusebenza Ngaxeshanye"

#: lib/Settings.php
msgid "Lower bound on concurrent WordPress probe workers per collector shard."
msgstr "Umda osezantsi wabasebenzi bovavanyo lwe-WordPress abasebenza ngaxeshanye kwicandelo ngalinye lomqokeleli."

#: lib/Settings.php
msgid "Maximum Concurrency"
msgstr "Ubuningi boKusebenza Ngaxeshanye"

#: lib/Settings.php
msgid "Upper bound on concurrent WordPress probe workers per collector shard."
msgstr "Umda ophezulu wabasebenzi bovavanyo lwe-WordPress abasebenza ngaxeshanye kwicandelo ngalinye lomqokeleli."

#: lib/Settings.php
msgid "HTTP User-Agent"
msgstr "Isihloko se-HTTP User-Agent"

#: lib/Settings.php
msgid "User-Agent header sent on read-only REST and Site Health probes."
msgstr "Isihloko se-User-Agent esithunyelwa kuvavanyo lokufunda kuphela lwe-REST noMpilo weSayithi."

#: lib/Settings.php
msgid "Fleet Health & Thold Thresholds"
msgstr "Impilo yeQela neMida ye-Thold"

#: lib/Settings.php
msgid "Default Apdex T (ms)"
msgstr "I-Apdex T eMiselweyo (ms)"

#: lib/Settings.php
msgid "Satisfied TTFB threshold T in milliseconds (tolerating threshold is 4T)."
msgstr "Umda owanelisayo we-TTFB T ngeemilisekondi (umda onyamezelwayo ngu-4T)."

#: lib/Settings.php
msgid "Autoload Bloat Warning (bytes)"
msgstr "Isilumkiso soKudumba kwe-Autoload (iibhayithi)"

#: lib/Settings.php
msgid "wp_options autoloaded size warning threshold (default 819200 / 800 KiB)."
msgstr "Umda wesilumkiso wobukhulu obulayishwa ngokuzenzekelayo kwi-wp_options (okumiselweyo ngu-819200 / 800 KiB)."

#: lib/Settings.php
msgid "Autoload Bloat Critical (bytes)"
msgstr "Umda oBalulekileyo woKudumba kwe-Autoload (iibhayithi)"

#: lib/Settings.php
msgid "wp_options autoloaded size critical threshold (default 2097152 / 2 MiB)."
msgstr "Umda obalulekileyo wobukhulu obulayishwa ngokuzenzekelayo kwi-wp_options (okumiselweyo ngu-2097152 / 2 MiB)."

#: lib/Settings.php
msgid "WP-Cron Lag Warning (seconds)"
msgstr "Isilumkiso soLibaziseko lwe-WP-Cron (imizuzwana)"

#: lib/Settings.php
msgid "Oldest overdue WP-Cron job lag threshold for degraded status."
msgstr "Umda wolibaziseko lomsebenzi we-WP-Cron omdala kakhulu ogqithileyo kwixesha lawo kwimeko eyehleyo."

#: lib/Settings.php
msgid "TLS Expiry Warning (days)"
msgstr "Isilumkiso soKuphelelwa kwe-TLS (iintsuku)"

#: lib/Settings.php
msgid "Days before TLS certificate expiry triggering degraded status."
msgstr "Iintsuku ngaphambi kokuphelelwa kwesatifikethi se-TLS ezibangela imeko eyehleyo."

#: lib/Settings.php
msgid "TLS Expiry Critical (days)"
msgstr "Umda oBalulekileyo woKuphelelwa kwe-TLS (iintsuku)"

#: lib/Settings.php
msgid "Days before TLS certificate expiry triggering critical status."
msgstr "Iintsuku ngaphambi kokuphelelwa kwesatifikethi se-TLS ezibangela imeko ebaluleke kakhulu."

#: lib/Settings.php
msgid "Keep Tables on Uninstall"
msgstr "Gcina iiTheyibhile xa uSusa"

#: lib/Settings.php
msgid "Preserve plugin_wordpress database tables when uninstalling the plugin."
msgstr "Gcina iitheyibhile zedathabheyisi ze-plugin_wordpress xa ususa iplagin."

