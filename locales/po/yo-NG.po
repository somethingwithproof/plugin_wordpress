msgstr "Àkójọ àti Àpótí Àṣírí WordPress"

#: lib/Settings.php
msgid "WordPress Fleet Security & Vault"
msgstr "Ààbò Àwọn Ojú-òpó àti Àpótí Àṣírí WordPress"

#: lib/Settings.php
msgid "Vault Keyfile Path"
msgstr "Ọ̀nà Fáìlì Kọ́kọ́rọ́ Àpótí Àṣírí"

#: lib/Settings.php
msgid "Absolute path to the external 256-bit AES-GCM keyfile used to encrypt Application Passwords at rest. Never replicated to remote pollers."
msgstr "Ọ̀nà pípé sí fáìlì kọ́kọ́rọ́ òde 256-bit AES-GCM tí a fi ń pa àwọn ọ̀rọ̀ìgbaniwọlé ohun èlò mọ́ ní ìkọ̀kọ̀ níbi ìpamọ́. A kì í ṣe ẹ̀dà rẹ̀ sí àwọn olùkójọ ìsọfúnni òkèèrè láéláé."

#: lib/Settings.php
msgid "Internal Host Allowlist"
msgstr "Àkójọ Àwọn Olùgbàlejò Inú Tí A Fọwọ́sí"

#: lib/Settings.php
msgid "Comma-separated hostnames or wildcard patterns (e.g. *.corp.example) exempt from private-IP SSRF blocking."
msgstr "Àwọn orúkọ olùgbàlejò tàbí ìlànà wildcard tí a fi kọ́mà pín (bíi *.corp.example) tí kò sí lábẹ́ ìdènà SSRF IP àdáni."

#: lib/Settings.php
msgid "Internal CIDR Allowlist"
msgstr "Àkójọ CIDR Inú Tí A Fọwọ́sí"

#: lib/Settings.php
msgid "Comma-separated internal CIDR ranges explicitly permitted by OutboundGuard."
msgstr "Àwọn ìwọ̀n CIDR inú tí a fi kọ́mà pín tí OutboundGuard fọwọ́sí ní gbangba."

#: lib/Settings.php
msgid "Outbound Client & Adaptive Poller Sizing"
msgstr "Oníbàárà Ìta àti Ìwọ̀n Olùkójọ Tó Ń Yípadà"

#: lib/Settings.php
msgid "Poll Interval (seconds)"
msgstr "Àlàfo Ìkójọ Ìsọfúnni (ìṣẹ́jú-àáyá)"

#: lib/Settings.php
msgid "Target fleet polling interval in seconds for Little's Law concurrency sizing."
msgstr "Àlàfo ìkójọ ìsọfúnni àfẹ́ṣe fún àwọn ojú-òpó ní ìṣẹ́jú-àáyá fún ìwọ̀n iṣẹ́-pọ̀ Little's Law."

#: lib/Settings.php
msgid "Connect Timeout (seconds)"
msgstr "Àkókò Ìparí Ìsopọ̀ (ìṣẹ́jú-àáyá)"

#: lib/Settings.php
msgid "Maximum TCP/TLS connect duration per WordPress probe (1-15s)."
msgstr "Àkókò púpọ̀ jùlọ fún ìsopọ̀ TCP/TLS lórí ìwádìí WordPress kọ̀ọ̀kan (1-15s)."

#: lib/Settings.php
msgid "Read Timeout (seconds)"
msgstr "Àkókò Ìparí Kíkà (ìṣẹ́jú-àáyá)"

#: lib/Settings.php
msgid "Maximum total HTTP read duration per WordPress probe (1-60s)."
msgstr "Àpapọ̀ àkókò púpọ̀ jùlọ fún kíkà HTTP lórí ìwádìí WordPress kọ̀ọ̀kan (1-60s)."

#: lib/Settings.php
msgid "Max Response Size (bytes)"
msgstr "Ìwọ̀n Èsì Púpọ̀ Jùlọ (báìtì)"

#: lib/Settings.php
msgid "Hard byte ceiling per HTTP response (capped at 2097152 bytes / 2 MiB)."
msgstr "Ààlà báìtì líle fún èsì HTTP kọ̀ọ̀kan (tí a pààlà sí báìtì 2097152 / 2 MiB)."

#: lib/Settings.php
msgid "CoDel Target Standing Delay (ms)"
msgstr "Àfẹ́ṣe Ìdádúró Tí Ó Dúró ti CoDel (ms)"

#: lib/Settings.php
msgid "Queue standing-delay target in milliseconds before adaptive concurrency backs off."
msgstr "Àfẹ́ṣe ìdádúró inú ìlà ní mílísẹ́kọ́ndì kí iṣẹ́-pọ̀ tó ń yípadà tó dínkù."

#: lib/Settings.php
msgid "Minimum Concurrency"
msgstr "Ìwọ̀n Iṣẹ́-pọ̀ Tó Kéré Jùlọ"

#: lib/Settings.php
msgid "Lower bound on concurrent WordPress probe workers per collector shard."
msgstr "Ààlà ìsàlẹ̀ fún àwọn òṣìṣẹ́ ìwádìí WordPress tí ń ṣiṣẹ́ lẹ́ẹ̀kan náà fún apá olùkójọ kọ̀ọ̀kan."

#: lib/Settings.php
msgid "Maximum Concurrency"
msgstr "Ìwọ̀n Iṣẹ́-pọ̀ Tó Pọ̀ Jùlọ"

#: lib/Settings.php
msgid "Upper bound on concurrent WordPress probe workers per collector shard."
msgstr "Ààlà òkè fún àwọn òṣìṣẹ́ ìwádìí WordPress tí ń ṣiṣẹ́ lẹ́ẹ̀kan náà fún apá olùkójọ kọ̀ọ̀kan."

#: lib/Settings.php
msgid "HTTP User-Agent"
msgstr "Àkọlé HTTP User-Agent"

#: lib/Settings.php
msgid "User-Agent header sent on read-only REST and Site Health probes."
msgstr "Àkọlé User-Agent tí a fi ránṣẹ́ lórí àwọn ìwádìí kíkà nìkan ti REST àti Ìlera Ojú-òpó."

#: lib/Settings.php
msgid "Fleet Health & Thold Thresholds"
msgstr "Ìlera Àwọn Ojú-òpó àti Àwọn Ààlà Thold"

#: lib/Settings.php
msgid "Default Apdex T (ms)"
msgstr "Apdex T Àkọ́kọ́ṣe (ms)"

#: lib/Settings.php
msgid "Satisfied TTFB threshold T in milliseconds (tolerating threshold is 4T)."
msgstr "Ààlà TTFB tí ó tẹ́nilọ́rùn T ní mílísẹ́kọ́ndì (ààlà ìfaradà jẹ́ 4T)."

#: lib/Settings.php
msgid "Autoload Bloat Warning (bytes)"
msgstr "Ìkìlọ̀ Ìwúkọ́ Autoload (báìtì)"

#: lib/Settings.php
msgid "wp_options autoloaded size warning threshold (default 819200 / 800 KiB)."
msgstr "Ààlà ìkìlọ̀ fún ìwọ̀n data tí ń gbé sókè fúnra rẹ̀ nínú wp_options (àkọ́kọ́ṣe 819200 / 800 KiB)."

#: lib/Settings.php
msgid "Autoload Bloat Critical (bytes)"
msgstr "Ààlà Pàtàkì Ìwúkọ́ Autoload (báìtì)"

#: lib/Settings.php
msgid "wp_options autoloaded size critical threshold (default 2097152 / 2 MiB)."
msgstr "Ààlà pàtàkì fún ìwọ̀n data tí ń gbé sókè fúnra rẹ̀ nínú wp_options (àkọ́kọ́ṣe 2097152 / 2 MiB)."

#: lib/Settings.php
msgid "WP-Cron Lag Warning (seconds)"
msgstr "Ìkìlọ̀ Ìfàsẹ́yìn WP-Cron (ìṣẹ́jú-àáyá)"

#: lib/Settings.php
msgid "Oldest overdue WP-Cron job lag threshold for degraded status."
msgstr "Ààlà ìfàsẹ́yìn iṣẹ́ WP-Cron tí ó pẹ́ jùlọ kọjá àkókò rẹ̀ fún ipò tí ó rẹ̀lẹ̀."

#: lib/Settings.php
msgid "TLS Expiry Warning (days)"
msgstr "Ìkìlọ̀ Ìparí TLS (ọjọ́)"

#: lib/Settings.php
msgid "Days before TLS certificate expiry triggering degraded status."
msgstr "Iye ọjọ́ kí ìwé-ẹ̀rí TLS tó parí tí ó ń fa ipò tí ó rẹ̀lẹ̀."

#: lib/Settings.php
msgid "TLS Expiry Critical (days)"
msgstr "Ààlà Pàtàkì Ìparí TLS (ọjọ́)"

#: lib/Settings.php
msgid "Days before TLS certificate expiry triggering critical status."
msgstr "Iye ọjọ́ kí ìwé-ẹ̀rí TLS tó parí tí ó ń fa ipò ewu pàtàkì."

#: lib/Settings.php
msgid "Keep Tables on Uninstall"
msgstr "Pa Àwọn Tábìlì Mọ́ Nígbà Ìyọkúrò"

#: lib/Settings.php
msgid "Preserve plugin_wordpress database tables when uninstalling the plugin."
msgstr "Pa àwọn tábìlì ibi ìpamọ́ data plugin_wordpress mọ́ nígbà tí o bá ń yọ àfikún náà kúrò."

