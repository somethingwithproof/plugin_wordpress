msgstr "WordPress 管理员"

#: lib/Pages.php
msgid "WordPress Fleet Overview"
msgstr "WordPress 集群概览"

#: lib/Pages.php
msgid "WordPress Drift & Probes"
msgstr "WordPress 漂移与探测"

#: lib/Pages.php
msgid "WordPress Inventory & Vault"
msgstr "WordPress 资产清单与密钥库"

#: lib/Settings.php
msgid "WordPress Fleet Security & Vault"
msgstr "WordPress 集群安全与密钥库"

#: lib/Settings.php
msgid "Vault Keyfile Path"
msgstr "密钥库密钥文件路径"

#: lib/Settings.php
msgid "Absolute path to the external 256-bit AES-GCM keyfile used to encrypt Application Passwords at rest. Never replicated to remote pollers."
msgstr "用于静态加密应用程序密码的外部 256-bit AES-GCM 密钥文件的绝对路径。绝不会复制到远程轮询器。"

#: lib/Settings.php
msgid "Internal Host Allowlist"
msgstr "内部主机允许列表"

#: lib/Settings.php
msgid "Comma-separated hostnames or wildcard patterns (e.g. *.corp.example) exempt from private-IP SSRF blocking."
msgstr "以逗号分隔的主机名或通配符模式（例如 *.corp.example），豁免私有 IP 的 SSRF 拦截。"

#: lib/Settings.php
msgid "Internal CIDR Allowlist"
msgstr "内部 CIDR 允许列表"

#: lib/Settings.php
msgid "Comma-separated internal CIDR ranges explicitly permitted by OutboundGuard."
msgstr "OutboundGuard 明确允许的、以逗号分隔的内部 CIDR 网段。"

#: lib/Settings.php
msgid "Outbound Client & Adaptive Poller Sizing"
msgstr "出站客户端与自适应轮询器容量调节"

#: lib/Settings.php
msgid "Poll Interval (seconds)"
msgstr "轮询间隔（秒）"

#: lib/Settings.php
msgid "Target fleet polling interval in seconds for Little's Law concurrency sizing."
msgstr "用于 Little's Law 并发规模计算的目标集群轮询间隔（秒）。"

#: lib/Settings.php
msgid "Connect Timeout (seconds)"
msgstr "连接超时（秒）"

#: lib/Settings.php
msgid "Maximum TCP/TLS connect duration per WordPress probe (1-15s)."
msgstr "每次 WordPress 探测的最大 TCP/TLS 连接时长（1-15s）。"

#: lib/Settings.php
msgid "Read Timeout (seconds)"
msgstr "读取超时（秒）"

#: lib/Settings.php
msgid "Maximum total HTTP read duration per WordPress probe (1-60s)."
msgstr "每次 WordPress 探测的最大 HTTP 总读取时长（1-60s）。"

#: lib/Settings.php
msgid "Max Response Size (bytes)"
msgstr "最大响应大小（字节）"

#: lib/Settings.php
msgid "Hard byte ceiling per HTTP response (capped at 2097152 bytes / 2 MiB)."
msgstr "每个 HTTP 响应的硬性字节上限（最高限制为 2097152 字节 / 2 MiB）。"

#: lib/Settings.php
msgid "CoDel Target Standing Delay (ms)"
msgstr "CoDel 目标持续延迟（ms）"

#: lib/Settings.php
msgid "Queue standing-delay target in milliseconds before adaptive concurrency backs off."
msgstr "自适应并发回退前的队列持续延迟目标值（毫秒）。"

#: lib/Settings.php
msgid "Minimum Concurrency"
msgstr "最小并发数"

#: lib/Settings.php
msgid "Lower bound on concurrent WordPress probe workers per collector shard."
msgstr "每个采集器分片的 WordPress 并发探测工作线程下限。"

#: lib/Settings.php
msgid "Maximum Concurrency"
msgstr "最大并发数"

#: lib/Settings.php
msgid "Upper bound on concurrent WordPress probe workers per collector shard."
msgstr "每个采集器分片的 WordPress 并发探测工作线程上限。"

#: lib/Settings.php
msgid "HTTP User-Agent"
msgstr "HTTP User-Agent 标头"

#: lib/Settings.php
msgid "User-Agent header sent on read-only REST and Site Health probes."
msgstr "在只读 REST 和站点健康探测中发送的 User-Agent 标头。"

#: lib/Settings.php
msgid "Fleet Health & Thold Thresholds"
msgstr "集群健康与 Thold 阈值"

#: lib/Settings.php
msgid "Default Apdex T (ms)"
msgstr "默认 Apdex T（ms）"

#: lib/Settings.php
msgid "Satisfied TTFB threshold T in milliseconds (tolerating threshold is 4T)."
msgstr "满意的 TTFB 阈值 T（毫秒，可容忍阈值为 4T）。"

#: lib/Settings.php
msgid "Autoload Bloat Warning (bytes)"
msgstr "自动加载膨胀警告（字节）"

#: lib/Settings.php
msgid "wp_options autoloaded size warning threshold (default 819200 / 800 KiB)."
msgstr "wp_options 自动加载大小的警告阈值（默认 819200 / 800 KiB）。"

#: lib/Settings.php
msgid "Autoload Bloat Critical (bytes)"
msgstr "自动加载膨胀严重警告（字节）"

#: lib/Settings.php
msgid "wp_options autoloaded size critical threshold (default 2097152 / 2 MiB)."
msgstr "wp_options 自动加载大小的严重阈值（默认 2097152 / 2 MiB）。"

#: lib/Settings.php
msgid "WP-Cron Lag Warning (seconds)"
msgstr "WP-Cron 延迟警告（秒）"

#: lib/Settings.php
msgid "Oldest overdue WP-Cron job lag threshold for degraded status."
msgstr "触发降级状态的最早逾期 WP-Cron 任务延迟阈值。"

#: lib/Settings.php
msgid "TLS Expiry Warning (days)"
msgstr "TLS 过期警告（天）"

#: lib/Settings.php
msgid "Days before TLS certificate expiry triggering degraded status."
msgstr "触发降级状态的 TLS 证书过期前剩余天数。"

#: lib/Settings.php
msgid "TLS Expiry Critical (days)"
msgstr "TLS 过期严重警告（天）"

#: lib/Settings.php
msgid "Days before TLS certificate expiry triggering critical status."
msgstr "触发严重状态的 TLS 证书过期前剩余天数。"

#: lib/Settings.php
msgid "Keep Tables on Uninstall"
msgstr "卸载时保留数据表"

#: lib/Settings.php
msgid "Preserve plugin_wordpress database tables when uninstalling the plugin."
msgstr "卸载插件时保留 plugin_wordpress 数据库表。"

#: lib/Ui/PagesRenderer.php
msgid "Fleet Health Summary"
msgstr "集群健康摘要"

#: lib/Ui/PagesRenderer.php
msgid "MAD Latency Anomalies"
msgstr "MAD 延迟异常"

#: lib/Ui/PagesRenderer.php
msgid "Site Snapshots"
msgstr "站点快照"

#: lib/Ui/PagesRenderer.php
msgid "Cacti Thold Baseline Templates"
msgstr "Cacti Thold 基线模板"

#: lib/Ui/PagesRenderer.php
msgid "Dry-Run Probe Site:"
msgstr "试运行探测站点:"

#: lib/Ui/PagesRenderer.php
msgid "Run Read-Only Probe"
msgstr "运行只读探测"

#: lib/Ui/PagesRenderer.php
msgid "Latest Dry-Run Probe Result"
msgstr "最新试运行探测结果"

#: lib/Ui/PagesRenderer.php
msgid "Update Drift, Cron Stalls & Autoload Bloat"
msgstr "更新漂移、Cron 停滞与自动加载膨胀"

#: lib/Ui/PagesRenderer.php
msgid "Vault Status:"
msgstr "密钥库状态:"

#: lib/Ui/PagesRenderer.php
msgid "Add or Update WordPress Site"
msgstr "添加或更新 WordPress 站点"

#: lib/Ui/PagesRenderer.php
msgid "Save Site"
msgstr "保存站点"

